model GenerationTask {
  id        Int          @id @default(autoincrement())
  projectId Int
  project   ImageProject @relation(fields: [projectId], references: [id])
  userId    Int
  user      User         @relation(fields: [userId], references: [id])
  // 任务来源：platform 本平台 / vidflowos VidFlowOS 代办（对账/取消按此选网关 Key；列表默认过滤）
  source    String       @default("platform") @db.VarChar(20)

  // 创作类型（与所属项目一致，建任务时从项目继承），便于任务中心按类型直接筛选
  type String @default("ECOMMERCE") @db.VarChar(20) // GENERAL 通用 / ECOMMERCE 电商 / PORTRAIT 人像

  // 生成模式与 AI 拆图任务编排字段。普通/人像任务保持 STANDARD，AI_SPLIT 按 groupId 聚合。
  generationMode  String  @default("STANDARD") @db.VarChar(30) // STANDARD / AI_SPLIT
  groupId         String? @db.VarChar(64)
  clientRequestId String? @db.VarChar(64)
  directionIndex  Int?
  aiSplitStage    String? @default("QUEUED") @db.VarChar(32)

  retryOfTaskId Int?
  retryOfTask   GenerationTask?  @relation("GenerationTaskRetry", fields: [retryOfTaskId], references: [id], onDelete: SetNull)
  retryTasks    GenerationTask[] @relation("GenerationTaskRetry")

  // 生图配置（多数为前端写死的枚举常量，存 String）
  presetCategory String  @db.VarChar(50) // 白底 / 场景 / 尺寸 / 卖点 / 细节 / 包装
  presetOption   String? @db.VarChar(100)
  model          String  @db.VarChar(100) // AI Gateway 模型 publicId
  prompt         String  @db.Text
  textAmount     String? @db.VarChar(20) // 无 / 少 / 中 / 多
  language       String? @db.VarChar(20)
  aspectRatio    String? @db.VarChar(20)
  n              Int     @default(4)
  imageLabelBase String? @db.VarChar(128) // 套图板块命名基名；为空时前端回退为“图 N”

  // 垫图 URL 快照（解耦 ProductImage 删除）
  refImageUrls Json?

  // 人像创作提示词配置快照；创作类型保存在 promptConfig.creation_type
  promptConfig Json?
  // 人像创作视角配置快照（单角度说明 / 四视角明细）
  viewConfig   Json?
  // 人像创作尺寸适配快照：用户目标 / 模型实际参数 / 最终交付策略与提示
  deliveryPlan Json?

  // AI Gateway 异步图片任务关联与终态回调幂等（与 VideoTask 保持一致）
  gatewayTaskId  String? @unique @db.VarChar(255)
  gatewayEventId String? @unique @db.VarChar(255)

  // generate 管线全量网关任务关联（审计/对账；2026-09-11）：1 任务 N 图 = N 网关任务，
  // 单值 gatewayTaskId 装不下，此列存 [{ gatewayTaskId, imageId, attemptNo }]；
  // 恰好 1 个网关任务时单值列同步冗余。结算闸门仍是执行器 CAS，此列纯审计。
  gatewayTaskIds Json?

  // 成品入库快照行的来源 ImageGenJob.id（2026-09-11）：批量改图等 t2i/i2i 生成完成后
  // 归档到项目时经 createTask 落的行。生成记录视图据此把扣费积分（流水盖
  // meta.jobId）挂到本行，并隐藏已归档的原始 IMAGEGEN 行（去重不双计）。
  sourceJobId String? @db.VarChar(64)

  // 整体状态（前端聚合后写入），与任务中心 Tab 一一对应
  // GENERATING=运行中 / SUCCESS=已完成 / FAILED=失败 / TIMEOUT=超时 / CANCELLED=已取消
  status       String  @default("GENERATING")
  errorMessage String? @db.Text

  // ── 通用生图后端迁移(Track A):执行侧字段,只增不改 ──
  // 冻结的执行规格:编译后 prompt、尺寸计划、引用图 Spaces key、provider 配置版本
  executionSpec   Json?
  // 取消标记(取消事务写入;执行器各阶段检查)
  cancelRequested Boolean   @default(false)
  // 任务 deadline(创建时间 + 10 分钟 + 5 分钟宽限;对账超时收敛用)
  deadlineAt      DateTime?

  generatedImages GeneratedImage[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([userId, clientRequestId, directionIndex])
  @@index([projectId, deletedAt])
  @@index([userId, status, createdAt])
  @@index([userId, type, createdAt])
  @@index([userId, generationMode, groupId])
  @@index([generationMode, aiSplitStage, updatedAt])
  @@index([retryOfTaskId])
}

model GeneratedImage {
  id     Int            @id @default(autoincrement())
  taskId Int
  task   GenerationTask @relation(fields: [taskId], references: [id])
  // 席位来源：跟随任务行 source（冗余存储，便于对账按席位选 Key）
  source String         @default("platform") @db.VarChar(20)

  url            String? @db.VarChar(1000)
  /// 模型原始输出图；人像创作永久保留，用于后续重新裁切而不重新生成
  originalUrl    String? @db.VarChar(1000)
  status         String  @default("GENERATING") // GENERATING / SUCCESS / FAILED
  providerJobId  String? @db.VarChar(255) // Flux / Qwen 异步任务 ID
  // 管线(imggen:)终态回调事件 id（审计：哪个事件终态了这张图；同图重试覆盖最新，
  // 结算幂等不依赖它——闸门是执行器 CAS settle）
  gatewayEventId String? @db.VarChar(255)
  errorMessage   String? @db.Text
  adopted        Boolean @default(false)
  order          Int     @default(0)
  width          Int? // 最终交付宽度
  height         Int? // 最终交付高度
  nativeWidth    Int? // 模型原生输出宽度
  nativeHeight   Int? // 模型原生输出高度
  deliveryMeta   Json? // 后处理策略、原生清晰度标记、降级原因

  // ── 通用生图后端迁移(Track A):执行租约字段,只增不改 ──
  leaseOwner     String?   @db.VarChar(64)
  leaseExpiresAt DateTime?
  attemptNo      Int       @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([taskId, deletedAt])
  @@index([status, leaseExpiresAt])
}

// ── 通用生图(t2i/i2i)异步 Job ─────────────────────────────────────────────
// 迁移自 Next 进程内 job store(globalThis Map + 30 分钟保留),行为契约一致:
// 对外快照分别是 t2i {status,url,usage} 与 i2i I2IJobSnapshot,内部状态不穿透。
model ImageGenJob {
  source String @default("platform") @db.VarChar(20)
  id     String @id // uuid,即返回给前端的 jobId
  userId Int
  user   User   @relation(fields: [userId], references: [id])

  kind   String @db.VarChar(20) // TEXT_TO_IMAGE / IMAGE_TO_IMAGE
  status String @default("QUEUED") // QUEUED / RUNNING / COMPLETED / FAILED(对外投影小写)

  request    Json? // 请求快照(prompt、provider、尺寸、引用图 Spaces key、i2i mode 等)
  taskId     Int? // i2i 且带 projectId 时关联的 image-project 任务 id
  traceId    String? @db.VarChar(64)
  tokenUsage Json? // 快照回传的用量(i2i 字段名 tokenUsage 保持一致)

  // 审计快照（生成记录视图）：从 request 提列，便于 SQL 筛选/分组（MySQL 下
  // Prisma 不支持 JSON path 过滤）。写入路径 t2i/i2i service 落库时同步盖。
  model  String? @db.VarChar(100) // request.provider（逻辑 id 或网关 model id）
  prompt String? @db.Text // request.prompt（keyword 检索面）

  // ── 车泰斗工作台复用（2026-09-28）──────────────────────────────────────
  // businessType：业务来源隔离。旧 t2i/i2i 管线 = IMAGE_CREATIVE（默认），
  // 车泰斗素材工作台 = CHETAIDOU（后端赋值，客户端不可传）。两条线的
  // 认领/对账/清理 runner 互不触碰对方行。
  businessType      String  @default("IMAGE_CREATIVE") @db.VarChar(32)
  businessTaskId    String? @unique @db.VarChar(36) // 指向车泰斗 GENERATE 根 ChetaidouTask.id；IMAGE_CREATIVE 恒 null
  cancelRequestedAt DateTime? // CHETAIDOU 取消标记

  expiresAt DateTime? // 创建 + 30 分钟;过期 GET 返回 404(对齐 Next 内存保留窗口);CHETAIDOU 恒 null 不套 30 分钟规则
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ImageGenItem[]

  @@index([userId, kind, createdAt])
  @@index([status, createdAt])
  @@index([businessType, status, createdAt])
  @@index([businessType, userId, createdAt])
}

model ImageGenItem {
  id    Int         @id @default(autoincrement())
  jobId String
  job   ImageGenJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  idx   Int
  label String?

  status       String  @default("QUEUED") // QUEUED / RUNNING / SUCCEEDED / FAILED → 对外 pending/ready/failed
  url          String? @db.VarChar(1000)
  errorMessage String? @db.Text
  usage        Json?
  gatewayImage Json? // Gateway 实际尺寸及 requested/actual/changes 回显

  providerJobId  String?   @db.VarChar(255)
  // 管线(imggen:)终态回调事件 id（审计，同 GeneratedImage.gatewayEventId 语义）
  gatewayEventId String?   @db.VarChar(255)
  leaseOwner     String?   @db.VarChar(64)
  leaseExpiresAt DateTime?
  attemptNo      Int       @default(0)

  // ── 车泰斗工作台复用（2026-09-28）：私有产物持久化 + 当前调用关联 ──────
  currentCallId String?   @db.VarChar(36) // 该图当前有效 ChetaidouCall.id
  fileKey       String?   @db.VarChar(1000) // 私有转存 key（CHETAIDOU 不写公开 url）
  mime          String?   @db.VarChar(100)
  width         Int?
  height        Int?
  errorCode     String?   @db.VarChar(64)

  // 通用软删除时间；执行/结算保留完整席位，展示、下载、重试显式排除已删除项。
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId, idx])
  @@index([status, leaseExpiresAt])
}

// 图片创作 — 内置提示词（管理员可动态增删改，前端 Composer / SceneConfig 拉取渲染）
model ImagePromptTemplate {
  id        Int      @id @default(autoincrement())
  dimension String   @db.VarChar(50) // 白底 / 场景 / 尺寸 / 卖点 / ... admin 自由填
  name      String   @db.VarChar(100) // 功能名称：正面 / 客厅 / 三视图
  prompt    String   @db.Text
  enabled   Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dimension, name])
  @@index([dimension, enabled, sortOrder])
}

// 图片创作 — 模板库分组（系统分组 + 个人分组，统一外键 ImageTemplate.groupId 关联）
// 个人分组：userId 指向归属用户、isSystem=false，可单独管理（新建空组 / 重命名 / 删除连带模板）。
// 系统分组：userId=null、isSystem=true，由管理员侧维护。
// 重命名只改本行（模板按 groupId 关联，名称随关系取），删除时连带软删组内模板。
// 硬删除（不进 SOFT_DELETE_MODELS），与 PricingConfig 一致。
// userId 可空，故个人分组唯一性由 @@unique([userId, name]) 约束，系统分组名唯一性由应用层保证。
model ImageTemplateGroup {
  id        Int     @id @default(autoincrement())
  userId    Int? // 个人分组归属用户；系统分组为 null
  user      User?   @relation(fields: [userId], references: [id])
  isSystem  Boolean @default(false)
  name      String  @db.VarChar(50)
  sortOrder Int     @default(0)

  templates ImageTemplate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, sortOrder])
}

// 图片创作 — 模板库
// 个人模板（isSystem=false，仅创建者可见）+ 系统模板（isSystem=true，管理员维护、全员可见）。
// 用户可见集合 = 自己的个人模板 ∪ 全部系统模板。
// 一个模板含 1..N 张图片条目，每条独立 prompt / 尺寸 / 文字量（沿用「父聚合 + 子席位」模式）。
model ImageTemplate {
  id       Int     @id @default(autoincrement())
  userId   Int // 创建者；系统模板记录创建它的管理员
  user     User    @relation(fields: [userId], references: [id])
  isSystem Boolean @default(false) // true=系统模板（全员可见），false=个人模板（仅本人可见）

  name    String              @db.VarChar(200) // 模板名
  groupId Int? // 分组外键：个人模板指向个人分组、系统模板指向系统分组（详见 ImageTemplateGroup）
  group   ImageTemplateGroup? @relation(fields: [groupId], references: [id])
  tags    Json? // 标签数组，如 ["A+","Amazon","官方推荐"]
  note    String?             @db.VarChar(500) // 备注

  items ImageTemplateItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isSystem, deletedAt])
  @@index([userId, deletedAt])
  @@index([groupId])
}

model ImageTemplateItem {
  id         Int           @id @default(autoincrement())
  templateId Int
  template   ImageTemplate @relation(fields: [templateId], references: [id])

  name        String  @default("默认") @db.VarChar(100) // 图片名称：标题图 / 默认
  prompt      String? @db.Text // 该张图的 prompt（选填）
  refImageUrl String? @db.VarChar(1000) // 参考/示例图
  aspectRatio String? @db.VarChar(20) // 尺寸：null=不指定，否则如 1:1 / 3:4 / 16:9
  textAmount  String? @db.VarChar(20) // 文字量：无文字 / 极少 / 常规 / 丰富

  // 分辨率（分字段存储，便于生图任务信息统一）
  resolutionTier String? @db.VarChar(20) // 分辨率档位：1K / 2K / 4K
  customAspectW  Int? // 自定义宽度
  customAspectH  Int? // 自定义高度
  customSizeMode String? @db.VarChar(20) // 自定义尺寸模式：pixels / ratio

  // AI 拆图模板快照：保留竞品结构和生图配置，后续换 SKU 复用时仍以新商品事实为准。
  competitorTemplate Json?
  generationSettings Json?
  site               String? @db.VarChar(30)
  promptVersion      String? @db.VarChar(20)
  promptHash         String? @db.Char(64)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateId, sortOrder])
  sourceMeta Json? // 预览墙公开生成/交付元信息

}

// ============================================================
// 敏感词提示库
// 管理员手工维护 + 后续 Listing 生成/AI 判定自动入库；按 (platform, word) 唯一。
// 物理删除（不挂软删扩展）：删了就真删了，新建同 (platform, word) 直接 create 即可。
// ============================================================

enum SensitiveWordRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum SensitiveWordSource {
  MANUAL // 后台管理员手动录入
  LISTING_GENERATION // Listing 生成流程自动入库
  AI_DETECTION // AI 判定后入库
}

model SensitiveWord {
  id         Int                    @id @default(autoincrement())
  word       String                 @db.VarChar(255)
  platform   String                 @db.VarChar(50) // 平台标识，小写归一：amazon / walmart / ...
  category   Json // 商品分类数组（自由文本，前端给候选）：["保健品", "美容"]
  riskLevel  SensitiveWordRiskLevel
  source     SensitiveWordSource
  suggestion String?                @db.Text // 建议替代 / 风险说明
  userId     Int? // 创建人；为 null 时来源必须是 AI_DETECTION（用于初始库导入等无归属场景）
  user       User?                  @relation(fields: [userId], references: [id])
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  @@unique([platform, word])
  @@index([userId])
  @@index([platform])
  @@index([source])
}

// =========================================================
// 视频创作 - 通用创作
// =========================================================

model VideoProject {
  id     Int    @id @default(autoincrement())
  name   String @default("未命名项目") @db.VarChar(200)
  type   String @default("GENERAL") @db.VarChar(20) // GENERAL 通用创作 / ECOMMERCE 带货创作
  // 任务来源：platform 本平台 / vidflowos VidFlowOS 代办的容器项目（列表默认过滤）
  source String @default("platform") @db.VarChar(20)
  userId Int
  user   User   @relation(fields: [userId], references: [id])

  tasks         VideoTask[]
  salesWorkflow SalesWorkflow? // 带货创作向导状态（仅 type=ECOMMERCE 时存在）

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, deletedAt])
  @@index([userId, type, deletedAt])
}

// 一个 VideoTask = 任务中心一条 = 一个输出视频（后端驱动，单视频，无席位子表）
model VideoTask {
  id        Int          @id @default(autoincrement())
  projectId Int
  project   VideoProject @relation(fields: [projectId], references: [id])
  userId    Int
  user      User         @relation(fields: [userId], references: [id])

  // 生成入参
  mode        String  @db.VarChar(50) // 模型业务分类，如 NORMAL / REFERENCE
  prompt      String  @db.Text
  model       String  @db.VarChar(100) // AI Gateway 模型 publicId
  modelName   String? @db.VarChar(200) // 创建任务时的模型展示名称快照
  durationSec Int     @default(6) // 3–15
  aspectRatio String? @db.VarChar(20) // 16:9 / 9:16 / 1:1；null=自动
  resolution  String? @db.VarChar(20) // 分辨率档位；null=自动

  // 声音
  generateAudio   Boolean @default(false) // 生成音频
  keepSourceAudio Boolean @default(false) // 保留参考视频原声

  // 常规模式：首/尾帧
  firstFrameUrl String? @db.VarChar(1000)
  lastFrameUrl  String? @db.VarChar(1000)

  // 参考素材快照
  refMaterials     Json?
  // 实际提交给 AI Gateway 的生成参数快照
  generationParams Json?

  // 异步状态
  status         String  @default("GENERATING") // GENERATING / SUCCESS / TIMEOUT / CANCELLED / FAILED
  providerJobId  String? @db.VarChar(255) // 旧动作复刻任务 ID，进程重启后续跑用
  // 任务来源：platform 本平台 / vidflowos VidFlowOS 代办（对账/取消按此选网关 Key；列表默认过滤）
  source         String  @default("platform") @db.VarChar(20)
  gatewayTaskId  String? @unique @db.VarChar(255) // AI Gateway Task ID
  gatewayEventId String? @unique @db.VarChar(255) // 已处理的 AI Gateway 回调事件 ID
  resultUrl      String? @db.VarChar(1000) // 成功后的视频 URL（Gateway 已存储到 Space）
  thumbnailUrl   String? @db.VarChar(1000) // 可选封面
  errorMessage   String? @db.Text // 失败原因（用户侧中文文案）
  gatewayError   Json? // 网关终态失败原始错误 { code, type, message, requestId }，排查用

  // 带货创作：出片历史统一锚在 SalesWorkflow 上（稳定，不随脚本重建而丢）。
  // salesBatchNo 标记「第几次成片」：同一次 generate 出的若干段共用一个批次号，
  // 构成一份连贯整片；重新生成 = 新批次（新版本），失败重试填回当前批次。
  // 分段生成用 segmentOrder 记录归属的分镜槽位；一键成片 segmentOrder 为 null。
  salesWorkflowId Int?
  salesWorkflow   SalesWorkflow? @relation("SalesWorkflowVideoTask", fields: [salesWorkflowId], references: [id])
  segmentOrder    Int? // 分段生成：归属分镜 order；一键成片为 null
  salesBatchNo    Int? // 成片批次号（同次 generate 共用；历史/旧数据为 null）

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([projectId, deletedAt])
  @@index([userId, status, createdAt])
  // 覆盖 loadHistory：按向导筛 + 按 createdAt 倒序取历史
  @@index([salesWorkflowId, createdAt])
  deliveryMeta Json? // 预览墙公开生成/交付元信息

}

// =========================================================
// 影刀 RPA 图片 / 视频创作
// 一个项目可同时包含图片和视频任务；一条任务按 quantity 拆成多个输出席位。
// =========================================================

model RpaCreationProject {
  id     Int    @id @default(autoincrement())
  name   String @default("未命名项目") @db.VarChar(200)
  userId Int
  user   User   @relation(fields: [userId], references: [id])

  tasks RpaCreationTask[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, deletedAt])
}

model RpaCreationTask {
  id              Int                @id @default(autoincrement())
  requestId       String             @unique @db.VarChar(36)
  clientRequestId String?            @db.VarChar(100)
  projectId       Int
  project         RpaCreationProject @relation(fields: [projectId], references: [id])
  userId          Int
  user            User               @relation(fields: [userId], references: [id])

  mediaType   String  @db.VarChar(10) // IMAGE / VIDEO
  inputMode   String? @db.VarChar(20) // 视频当前固定 INGREDIENTS
  prompt      String  @db.Text
  model       String  @db.VarChar(50)
  aspectRatio String  @db.VarChar(10)
  quantity    Int     @default(1)
  durationSec Int?
  resolution  String? @db.VarChar(10) // 视频 360p / 720p；旧视频为空时按 720p 下发

  referenceImageUrls Json
  referenceVideoUrls Json
  paramsSnapshot     Json?

  paramsFileKey      String? @db.VarChar(1000)
  yingdaoTaskUuid    String? @db.VarChar(255)
  yingdaoJobUuidList Json?

  status          String    @default("PENDING") @db.VarChar(30) // PENDING / SUCCESS / TIMEOUT / CANCELLED
  progressMessage String?   @db.VarChar(1000)
  errorMessage    String?   @db.Text
  startedAt       DateTime?
  completedAt     DateTime?
  expiresAt       DateTime?

  outputs RpaCreationOutput[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([userId, clientRequestId])
  @@index([projectId, createdAt])
  @@index([userId, status, createdAt])
}

model RpaCreationOutput {
  id     Int             @id @default(autoincrement())
  taskId Int
  task   RpaCreationTask @relation(fields: [taskId], references: [id])

  order        Int
  status       String  @default("PENDING") @db.VarChar(20) // PENDING / GENERATING / SUCCESS / FAILED
  url          String? @db.VarChar(1000)
  errorMessage String? @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([taskId, order])
  @@index([taskId, status])
  deliveryMeta Json? // 预览墙公开生成/交付元信息

}

// =========================================================
// 批量工作流 - 美妆创作
// 独立于 VideoProject / VideoTask，便于后续整体迁移到其它系统。
// 角色卡与数字人仍复用 DigitalHuman；任务仅保存来源 ID（无外键）和不可变快照。
// =========================================================

model BeautyProject {
  id     Int    @id @default(autoincrement())
  name   String @default("未命名美妆项目") @db.VarChar(200)
  userId Int
  user   User   @relation(fields: [userId], references: [id])

  tasks BeautyTask[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, deletedAt])
}

model BeautyTask {
  id        Int           @id @default(autoincrement())
  projectId Int
  project   BeautyProject @relation(fields: [projectId], references: [id])
  userId    Int
  user      User          @relation(fields: [userId], references: [id])

  // 同一次批量提交共用 batchKey；前端调整参数重提时会创建新批次
  batchKey      String @db.VarChar(36)
  batchIndex    Int
  attempt       Int    @default(1)
  retryOfTaskId Int?

  // 只保存来源数字人 ID，不建立跨域外键；真正用于生成和历史展示的是不可变快照
  sourceDigitalHumanId Int?
  digitalHumanSnapshot Json
  beautyInput          Json

  // 生成参数与参考素材快照
  prompt             String  @db.Text
  promptVersion      String? @db.VarChar(50)
  model              String  @db.VarChar(100)
  generationParams   Json? // 实际提交给 AI Gateway 的生成参数快照
  durationSec        Int?
  aspectRatio        String? @db.VarChar(20)
  resolution         String? @db.VarChar(20)
  generateAudio      Boolean @default(false)
  referenceImageUrls Json?
  referenceVideoUrls Json?
  referenceAudioUrls Json?

  // 任务中心状态：GENERATING / SUCCESS / TIMEOUT / CANCELLED / FAILED
  status         String    @default("GENERATING") @db.VarChar(20)
  gatewayTaskId  String?   @unique @map("providerJobId") @db.VarChar(255) // AI Gateway Task ID，复用原物理列
  gatewayEventId String?   @unique @db.VarChar(255) // 已处理的 Gateway 终态事件 ID
  resultUrl      String?   @db.VarChar(1000)
  thumbnailUrl   String?   @db.VarChar(1000)
  errorMessage   String?   @db.Text // 失败原因（用户侧中文文案）
  gatewayError   Json? // 网关终态失败原始错误 { code, type, message, requestId }，排查用
  startedAt      DateTime  @default(now())
  submittedAt    DateTime?
  finishedAt     DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([batchKey, batchIndex, attempt])
  @@index([projectId, deletedAt])
  @@index([userId, status, createdAt])
  @@index([sourceDigitalHumanId])
  @@index([retryOfTaskId])
  deliveryMeta Json? // 预览墙公开生成/交付元信息

}

// =========================================================
// 视频创作 - 带货创作（五步向导：产品&痛点 → 选素材 → 生成脚本 → 确认出片 → 成片预览）
// 后端定位：向导状态存储 + 触发视频生成（复用 VideoTask 链路）。
// 识图/手册/痛点/脚本等 AI 全在前端跑，后端只存其产出（productInfo / painPoints / segments）。
// =========================================================

// 带货创作向导状态：1:1 挂在 type=ECOMMERCE 的 VideoProject 上
model SalesWorkflow {
  id        Int          @id @default(autoincrement())
  projectId Int          @unique
  project   VideoProject @relation(fields: [projectId], references: [id])
  userId    Int
  user      User         @relation(fields: [userId], references: [id])

  // Step1 产品图（上限 3，URL 快照；可来自上传或素材池）
  productImages Json? // [{ url, name?, fromPoolImageId? }]

  // Step1 产品信息：四选一信息源（互斥，只取一种），前端解析后写回
  infoSource    String? @db.VarChar(20) // TEXT 文字描述 / URL Amazon链接 / IMAGE AI识图 / MANUAL 产品手册
  textInput     String? @db.Text // 文字描述原文
  sourceUrl     String? @db.VarChar(1000) // Amazon 链接
  manualFileUrl String? @db.VarChar(1000) // 产品手册文件 URL
  productInfo   Json? // 统一 schema 结构化商品信息（提取后可编辑）

  // Step1 痛点（前端 AI 生成 + 可增删/编辑/勾选）
  painPoints Json? // [{ text, selected }]

  // Step2 选素材（各上限 1，拍平快照，与素材池解耦）
  digitalHuman Json? // { id?, name, portraitUrl?, persona? } | null
  scene        Json? // { id?, name, imageUrl?, desc? } | null

  // Step3 脚本 / 出片参数（全能参考模式锁定）
  model         String? @db.VarChar(100) // AI Gateway 模型 publicId
  totalDuration Int? // 成片总时长（取所选模型支持档）
  generateAudio Boolean @default(false)
  aspectRatio   String? @db.VarChar(20) // 默认 9:16
  resolution    String? @db.VarChar(20)

  // Step4 成片方式：ONESHOT 一键成片（拼接成 1 个任务）/ SEGMENTED 分段生成（每段 1 个任务）
  outputMode String      @default("ONESHOT") @db.VarChar(20)
  // 出片历史统一锚点：一键成片 segmentOrder=null，分段生成 segmentOrder=分镜 order。
  // 锚在向导上而非分镜行，脚本重建（saveScript 删分镜）不会丢历史。最新一条为当前成片。
  videoTasks VideoTask[] @relation("SalesWorkflowVideoTask")

  segments SalesSegment[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, deletedAt])
}

// 分镜脚本行：每行 = 一个视频片段（对应一个 VideoTask）
model SalesSegment {
  id         Int           @id @default(autoincrement())
  workflowId Int
  workflow   SalesWorkflow @relation(fields: [workflowId], references: [id])

  order     Int // 分镜顺序（从 0 起）
  startSec  Int // 区间起（0,4,8…）
  endSec    Int // 区间止
  vidPrompt String @db.Text // 视频提示词（参考生视频，可编辑）
  voiceover String @db.Text // 口播文案 中文/English（可编辑）

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([workflowId, order])
}

// =========================================================
// 素材池（素材图 / 数字人 / 场景）
// =========================================================

// 素材图：图片创作产出（变体 / 手动存入）的沉淀池
model PoolImage {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])

  url         String? @db.VarChar(1000) // 真实图 URL；null → 前端用 hue 占位渲染
  hue         Int     @default(0) // 占位渐变色相（0–360）
  name        String  @db.VarChar(200) // 名称（搜索 + 去重键）
  prompt      String? @db.Text // 搜索用，卡片不显示
  sourceLabel String? @db.VarChar(100) // 派生来源标签（如「生成1·变体」）
  tags        Json? // string[]
  categories  Json? // string[]
  kind        String  @default("image") @db.VarChar(20) // 素材类型：image=普通素材图 / competitor=AI 拆图竞品参考图

  // 项目归属（软关联不做外键，素材池资产不随项目强绑定生命周期）：
  // competitor 图按项目隔离；null = 公共库（存量数据、手动存入、分享码导入）
  projectId Int?

  // 分组归属（null = 不归组，对应 PRD group:''）
  groupId Int?
  group   PoolGroup? @relation(fields: [groupId], references: [id])

  // 变体血缘：指向源图（同为 PoolImage）；源图常未入池则为 null，靠 sourceLabel 兜底
  sourceImageId Int?
  sourceImage   PoolImage?  @relation("ImageVariants", fields: [sourceImageId], references: [id])
  variants      PoolImage[] @relation("ImageVariants")

  order Int @default(0) // 排序（变体排在源图之后）

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, deletedAt])
  @@index([userId, groupId])
  @@index([sourceImageId])
  sourceMeta Json? // 预览墙公开生成/交付元信息

}

// 素材图分组：纯用户自建，无默认分组
model PoolGroup {
  id        Int    @id @default(autoincrement())
  userId    Int
  user      User   @relation(fields: [userId], references: [id])
  name      String @db.VarChar(50)
  sortOrder Int    @default(0)

  images PoolImage[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // 同名校验在 service 层做（尊重软删，删除后名字可复用）；DB 唯一索引会把软删行也算进去，故不建
  @@index([userId, name])
  @@index([userId, sortOrder])
}

// 数字人：可复用创作角色（人物图 + 视频 + 音色描述 + 隐藏人设），与曦灵 Avatar/Voice 无关
model DigitalHuman {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])

  name       String  @db.VarChar(200)
  portraits  Json? // [{ id, name, hue, img? }]
  videos     Json? // [{ id, name }]
  voiceDesc  String? @db.Text // 音色描述
  voiceAudio String? @db.VarChar(1000) // 上传的音频 URL（可选）
  persona    String? @db.Text // 人设/主体身份（隐藏字段，提交模型用，永不进可见 prompt）
  purposes   Json? // string[]
  tags       Json? // string[]
  roleCard   Json? // AI 角色卡专属：{ direction, cardType, imageModel, modules:{...7段文本} }；手动数字人为 null

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, deletedAt])
}

// 场景：可复用拍摄/带货背景（场景图 + 视频 + 描述）
model Scene {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])

  name       String  @db.VarChar(200)
  images     Json? // [{ id, name, hue, img? }]
  videos     Json? // [{ id, name }]
  desc       String? @db.Text // 场景描述（生成时拼进可见 prompt）
  categories Json? // string[]
  tags       Json? // string[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, deletedAt])
}

// 灵感雷达：用户订阅（关键词 + 平台选择 + 每平台抓取数）
model InspirationSubscription {
  id               Int       @id @default(autoincrement())
  userId           Int
  user             User      @relation(fields: [userId], references: [id])
  name             String    @db.VarChar(100)
  keywords         Json // String[]
  keywordVariants  Json? // { "spring garden": ["garden ideas", ...], ... }
  selectedVariants Json? // { "spring garden": ["garden ideas", "patio garden"], ... }
  platforms        Json // ["PINTEREST","INSTAGRAM","TIKTOK"]
  countPerPlatform Json // { "PINTEREST": 20, "INSTAGRAM": 30 }
  lastRefreshedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  items InspirationItem[]

  @@index([userId])
}

// 灵感雷达：抓取结果条目
model InspirationItem {
  id             Int                     @id @default(autoincrement())
  subscriptionId Int
  subscription   InspirationSubscription @relation(fields: [subscriptionId], references: [id])
  platform       String                  @db.VarChar(20) // PINTEREST | INSTAGRAM | TIKTOK
  mediaType      String                  @db.VarChar(10) // image | video
  mediaUrl       String                  @db.Text
  thumbnailUrl   String?                 @db.Text
  sourceUrl      String?                 @db.Text
  title          String?                 @db.Text
  likes          Int                     @default(0)
  comments       Int                     @default(0)
  saves          Int                     @default(0)
  views          Int                     @default(0)
  durationSec    Float?
  authorName     String?                 @db.VarChar(200)
  authorUrl      String?                 @db.Text
  externalId     String?                 @db.VarChar(200)
  createdAt      DateTime                @default(now())

  @@unique([subscriptionId, platform, externalId])
  @@index([subscriptionId])
}

// AI 商品工厂：制作记录（软删除，读操作自动过滤 deletedAt）
model ProductFactoryRecord {
  id            Int       @id @default(autoincrement())
  userId        Int // 用户隔离
  sourceType    String    @db.VarChar(20) // competitor；own_product/selection/inspiration 预留
  productName   String    @db.VarChar(200) // 默认 "竞品复刻 · {首个ASIN}"，分析后更新
  market        String    @db.VarChar(20) // amazon_us / amazon_uk / amazon_de
  status        String    @default("draft") @db.VarChar(20) // draft / in_progress / completed
  currentStep   Int       @default(1)
  totalSteps    Int       @default(6) // 创建时按 sourceType 定死
  thumbnailUrl  String?   @db.VarChar(500)
  sourceInput   Json // 来源原始输入
  brandIdentity Json? // 品牌基因快照/覆盖
  step1Data     Json? // DeconstructResult
  step2Data     Json? // AnalysisResult
  step3Data     Json? // { listingResult, scoreResult }
  step4Data     Json? // ImageStepData
  step5Data     Json? // AplusStepData
  step6Data     Json? // SopResult
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, status])
}

// ==================== 充值计费（订单 / 收据） ====================

// 订单类型：个人订阅/续费/升档/充值 + 团队购买/续费/升席/充值 + 个人转团队
enum BillingOrderType {
  PLAN_NEW // 个人新订阅
  PLAN_RENEW // 个人续费（排队）
  PLAN_UPGRADE // 个人升档补差
  PACK // 个人充值包
  CUSTOM // 个人自定义充值
  TEAM_PLAN // 团队版新购（自助）
  TEAM_RENEW // 团队续费（排队/恢复）
  TEAM_SEAT_UPGRADE // 团队升席位档（整月差价）
  TEAM_PACK // 团队共享池充值包
  TEAM_CUSTOM // 团队自定义充值
  PERSONAL_TO_TEAM // 个人转团队（折抵）
}

enum BillingOrderStatus {
  CREATED // 已创建（未发起支付）
  PENDING // 支付中（已创建 PaymentIntent）
  PAID // webhook 已确认收款（待入账）
  SETTLED // 已入账（终态）
  EXPIRED // 扫码超时（终态）
  CANCELLED // 已取消（终态）
  ABANDONED // 弃单/异常待人工（金额不符等）
}

enum PaymentChannel {
  WECHAT // 微信（PaymentIntent 内嵌 QR）
  ALIPAY // 支付宝（redirect 收银台）
  CARD // 银行卡（Elements 卡表单）
  ADMIN // 后台人工/定制开通（不走 Stripe）
}

model BillingOrder {
  id                    Int                @id @default(autoincrement())
  orderNo               String             @unique @db.VarChar(40) // SR 系规则，后端生成
  userId                Int
  user                  User               @relation(fields: [userId], references: [id])
  type                  BillingOrderType
  status                BillingOrderStatus @default(CREATED)
  channel               PaymentChannel?
  paymentProvider       String             @default("STRIPE") @db.VarChar(20) // STRIPE 海外 / ALLINPAY 国内，建单固定
  allinpayReqsn         String?            @unique @db.VarChar(32) // 通联商户订单号，请求前绑定
  allinpayTrxid         String?            @unique @db.VarChar(32) // 通联交易流水号，防串单
  allinpayQrCode        String?            @db.Text // 支付二维码原串，仅待支付期间使用
  paymentExpiresAt     DateTime?          // 支付截止时间，重复查询不延长
  amountCny             Decimal            @db.Decimal(10, 2) // 应付人民币（元，后端重算）
  fxRate                Decimal?           @db.Decimal(10, 4) // 汇率快照：1 USD = X CNY（发起支付时落库）
  amountUsdCents        Int? // 实收美元（美分）= round(amountCny*100/fxRate)，发起支付时落库
  creditsTotal          Int? // 到账积分合计（快照）
  teamId                Int? // 团队订单（弱引用 Team.id）
  packChoice            String?            @db.VarChar(20) // PERSONAL_TO_TEAM: inject | keep
  receiptEmail          String?            @db.VarChar(100) // 下单时指定的收据接收邮箱（空则用账号邮箱）
  stripePaymentIntentId String?            @db.VarChar(100)
  stripeClientSecret    String?            @db.VarChar(255) // 卡表单用，不落日志
  idempotencyKey        String?            @unique @db.VarChar(64)
  snapshot              Json // 商品/价格/到账/有效期变化快照
  paidAt                DateTime?
  settledAt             DateTime?
  expiredAt             DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  items                 BillingOrderItem[]
  receipt               Receipt?

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([stripePaymentIntentId]) // 支付回跳丢 orderNo 时按 payment_intent 反查
}

model BillingOrderItem {
  id        Int          @id @default(autoincrement())
  orderId   Int
  order     BillingOrder @relation(fields: [orderId], references: [id])
  name      String       @db.VarChar(200) // 项目名（剔除"赠送"字样）
  detail    String?      @db.VarChar(500)
  qty       Int          @default(1)
  amountCny Decimal      @db.Decimal(10, 2) // 人民币（元），折抵行为负
  credits   Int?
}

// 收据：SETTLED 即开票（snapshot 冻结正文字段）；查看=网页渲染，下载=前端 PDF，邮件=后端 PDF 附件
model Receipt {
  id        Int           @id @default(autoincrement())
  receiptNo String        @unique @db.VarChar(40) // SR+YYYYMMDDHHmmss+3位随机
  orderId   Int?          @unique // 手工充值补开时为空 → 挂 manualRef
  order     BillingOrder? @relation(fields: [orderId], references: [id])
  manualRef String?       @db.VarChar(100) // 补开来源（creditTransaction 标识）
  userId    Int
  user      User          @relation(fields: [userId], references: [id])
  email     String        @db.VarChar(120)
  title     String?       @db.VarChar(100) // 预留（一期固定个人）
  taxNo     String?       @db.VarChar(50) // 预留
  amountCny Decimal       @db.Decimal(10, 2)
  snapshot  Json // 收据全部正文字段（开票即冻结）
  emailedAt DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, createdAt])
}

// ==================== 企业团队 ====================

enum TeamSource {
  CUSTOM // 平台定制（后台手工开通）
  SELF // 自助购买
}

enum TeamStatus {
  ACTIVE
  GRACE // 宽限（到期后 30 天，冻结消费）
  ARCHIVED // 归档（套餐池清零/充值包退回管理员个人户/释放成员归属）
  DISABLED // 平台停用
}

enum TeamQuotaMode {
  SHARED // 共享池 + 成员月度封顶
  INDEPENDENT // 成员独立配额
}

enum OverLimitPolicy {
  BLOCK // 超额阻断
  WARN // 超额告警放行
}

enum TeamRole {
  ADMIN
  MEMBER
}

model Team {
  id                Int               @id @default(autoincrement())
  name              String?           @db.VarChar(100)
  nameFilled        Boolean           @default(false) // 企业名是否被显式设置过（false=系统落的默认名「{管理员用户名}的团队」，前端据此判"未命名"提示，不再比对字符串）
  source            TeamSource
  status            TeamStatus        @default(ACTIVE)
  tier              Int? // 自助档：1=standard 2=flagship；CUSTOM 为空
  seats             Int
  adminId           Int
  admin             User              @relation("TeamAdmin", fields: [adminId], references: [id])
  invitedById       Int? // 企业邀请人快照 = 建队时管理员的 invitedById（企业池消费的返利沿此链结算；无 FK 纯快照，管理员变更/账号删除不影响历史归属；存量团队为空时结算回落当前管理员邀请关系）
  discount          Decimal           @default(1) @db.Decimal(4, 3) // 共享池计价折扣；SELF 固定 1.00
  expiresAt         DateTime
  graceUntil        DateTime? // expiresAt+30d（快照）
  dataKeepUntil     DateTime? // expiresAt+60d
  archivedAt        DateTime?
  quotaMode         TeamQuotaMode     @default(SHARED)
  overLimitPolicy   OverLimitPolicy   @default(WARN)
  defaultModelText  String?           @db.VarChar(50)
  defaultModelImage String?           @db.VarChar(50)
  defaultModelVideo String?           @db.VarChar(50)
  contractAmountCny Decimal?          @db.Decimal(10, 2) // 平台定制：合同金额人民币（仅留痕）
  contractNote      String?           @db.VarChar(500)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  members           TeamMember[]
  modelConfigs      TeamModelConfig[]
  auditLogs         TeamAuditLog[]

  @@index([status, expiresAt])
}

model TeamMember {
  teamId             Int
  team               Team     @relation(fields: [teamId], references: [id])
  userId             Int
  user               User     @relation(fields: [userId], references: [id])
  role               TeamRole @default(MEMBER)
  monthlyQuota       Int? // 月度上限（SHARED 封顶 / INDEPENDENT 配额）
  quotaUsedThisMonth Decimal  @default(0) @db.Decimal(18, 4)
  quotaMonth         String?  @db.VarChar(7) // 懒重置标记 "2026-08"
  status             String   @default("ACTIVE") @db.VarChar(20)
  joinedAt           DateTime @default(now())

  @@id([teamId, userId])
  @@index([userId, status])
}

// 模型配置-按功能模块
model TeamModelConfig {
  id               Int     @id @default(autoincrement())
  teamId           Int
  team             Team    @relation(fields: [teamId], references: [id])
  moduleKey        String  @db.VarChar(50)
  allowedModels    Json
  defaultModel     String  @db.VarChar(50)
  memberSelectable Boolean @default(true)

  @@unique([teamId, moduleKey])
}

enum AiModelKind {
  TEXT
  IMAGE
  VIDEO
}

// AI 模型目录（模型配置 Tab 的可选池，seed 维护；active=false 即下架，不再出现在选项里）
model AiModel {
  id        Int         @id @default(autoincrement())
  code      String      @unique @db.VarChar(50)
  name      String      @db.VarChar(100)
  kind      AiModelKind
  active    Boolean     @default(true)
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([kind, active])
}

model TeamAuditLog {
  id        Int      @id @default(autoincrement())
  teamId    Int
  team      Team     @relation(fields: [teamId], references: [id])
  actorId   Int
  action    String   @db.VarChar(50)
  meta      Json?
  createdAt DateTime @default(now())

  @@index([teamId, createdAt])
}

// 团队套餐档（种子）
model TeamPlan {
  id                 Int      @id @default(autoincrement())
  tier               Int      @unique // 1 standard / 2 flagship
  name               String   @db.VarChar(50)
  priceCny           Decimal  @db.Decimal(10, 2)
  originalPriceCny   Decimal? @db.Decimal(10, 2)
  seats              Int
  poolPackageCredits Int
  poolGiftCredits    Int
  periodDays         Int      @default(30)
  active             Boolean  @default(true)
}

// 团队充值包（种子）
model TeamPack {
  id           Int     @id @default(autoincrement())
  priceCny     Decimal @unique @db.Decimal(10, 2)
  baseCredits  Int
  bonusCredits Int
  sortOrder    Int     @default(0)
  active       Boolean @default(true)
}

// ==================== 自定义充值阶梯 / 全局返利规则 ====================

// 自定义充值阶梯（配置化；scope=PERSONAL|TEAM）
model CustomLadderTier {
  id        Int     @id @default(autoincrement())
  scope     String  @db.VarChar(20) // PERSONAL | TEAM
  minCny    Decimal @db.Decimal(10, 2) // 门槛（元，含）
  bonusRate Decimal @db.Decimal(4, 3) // 赠送比例
  sortOrder Int     @default(0)

  @@index([scope, sortOrder])
}

// 全局返利规则（单行配置，id 固定 1）
model RebateRule {
  id               Int      @id @default(autoincrement())
  corpCounts       Boolean  @default(true) // 企业成员消耗走企业池时是否计入返利
  maxLayers        Int?     @default(2) // 返利层数（null=不限层级，沿邀请链上溯到底）
  perInviterCap    Int? // 邀请人单月返利封顶（积分，null=不限）
  perConsumeCapPct Decimal? @db.Decimal(4, 3) // 单笔返利占消耗比例上限（null=不限）
  updatedAt        DateTime @updatedAt
}

// ==================== Skill 市场 ====================

// 技能主表（种子维护；download_count/download_event_count 是缓存字段，真实来源是下面两张表）
model SkillMarketSkill {
  id                 Int                    @id @default(autoincrement())
  skillId            String                 @unique @db.VarChar(64) // 前后端稳定业务 ID：trending / listing-opt ...
  name               String                 @db.VarChar(100) // 中文名（运营可读，接口不依赖前端元数据）
  category           String                 @db.VarChar(50) // 运营场景分类
  status             SkillMarketSkillStatus @default(ACTIVE)
  fileUrl            String?                @db.VarChar(500) // 正文公开直链（Spaces public-read + Content-Disposition 烧入对象元数据）；null = 未上传，前端兜底本地拼装
  downloadCount      BigInt                 @default(0) // 历史成功下载过的去重用户数（removedAt 不影响）
  downloadEventCount BigInt                 @default(0) // 所有有效下载事件数（含重复下载）
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([status])
}

// 用户下载关系表：一名用户一个技能只有一行；移出列表只置 removedAt，永不删行（保住去重口径）
model SkillMarketUserSkill {
  id                Int       @id @default(autoincrement())
  userId            Int
  user              User      @relation(fields: [userId], references: [id])
  skillId           String    @db.VarChar(64) // 技能业务 ID，与事件表一致
  firstDownloadedAt DateTime // 第一次下载时间
  lastDownloadedAt  DateTime // 最近一次下载时间
  downloadTimes     Int       @default(1) // 该用户累计下载次数
  removedAt         DateTime? // 非空 = 已移出个人列表；重新下载时清空
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([userId, skillId])
  @@index([skillId, removedAt])
}

// 下载事件表：不可变审计日志；clientRequestId 唯一索引是幂等的最后防线
model SkillMarketDownloadEvent {
  id              Int      @id @default(autoincrement())
  clientRequestId String   @unique @db.VarChar(36) // 前端生成的幂等键
  userId          Int
  skillId         String   @db.VarChar(64)
  createdAt       DateTime @default(now())
  ipHash          String?  @db.VarChar(64) // sha256(ip)，不存明文
  userAgent       String?  @db.VarChar(255) // 截断存储

  @@index([skillId, createdAt])
  @@index([userId, createdAt])
}

enum SkillMarketSkillStatus {
  ACTIVE
  DISABLED
}

// ==================== 公告管理 ====================

/// 平台公告；软删除（deletedAt），生效区间 [startAt, endAt]，边界相接不算重叠
model Announcement {
  id          Int       @id @default(autoincrement())
  content     String    @db.Text // 公告正文
  startAt     DateTime // 生效开始时间
  endAt       DateTime // 生效结束时间（须晚于 startAt）
  createdById Int // 创建人
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  deletedAt   DateTime? // 非空 = 已软删除

  @@index([startAt, endAt])
  @@index([createdById])
}

// ==================== 车泰斗 AI 商品素材工作台（2026-09-28）====================
// 方案：docs/designs/2026-09-28-chetaidou-material-workbench-backend-implementation-plan.md
// 8 张新业务表 + 复用 ImageGenJob/ImageGenItem（businessType=CHETAIDOU）。
// 生图批次与逐张结果唯一落在 ImageGenJob/ImageGenItem，组合结果唯一保存在
// COMPOSE 根 ChetaidouTask.output；Call 是逐次模型调用账本（执行恢复+对账）。

/// SKU 目录（首期仅 CS1plus；由 scripts/init-chetaidou-production.mjs 初始化，不提供新增 SKU 接口）
model ChetaidouSku {
  id            Int      @id @default(autoincrement())
  code          String   @unique @db.VarChar(50) // "CS1plus"
  name          String   @db.VarChar(200)
  enabled       Boolean  @default(false) // 资料未齐前不启用；非 ENABLED 服务端拒绝新任务
  currentFactId Int? // 当前生效 ChetaidouFactCard.id
  revision      Int      @default(0) // 维护端乐观锁
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// SKU 事实卡（硬约束摘要），只追加不覆盖；任务快照按 id+version 冻结
model ChetaidouFactCard {
  id          Int      @id @default(autoincrement())
  skuId       Int
  version     Int // 发布时锁 SKU 行分配递增
  content     Json // PRD §4.5 硬约束摘要（R1/R2/R4/R6/R7/R8/R9）+ 维护方确认的 scope
  contentHash String   @db.VarChar(64)
  confirmedBy Int // 审计人 = 登录用户 id
  confirmedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([skuId, version])
}

/// 母版图（预置 PRESET / 用户上传 USER_UPLOAD），文件不可变；重传创建新行
model ChetaidouImage {
  id                    Int      @id @default(autoincrement())
  skuId                 Int // 归属服务端裁定
  sourceType            String   @db.VarChar(20) // PRESET / USER_UPLOAD
  ownerId               Int? // PRESET=null；上传图=本人
  createdBy             Int
  title                 String   @db.VarChar(200)
  number                String?  @db.VarChar(100) // 母版编号（搜索用）
  fileKey               String   @db.VarChar(1000) // Spaces 私有 key
  mime                  String   @db.VarChar(100)
  width                 Int
  height                Int
  checksum              String   @db.VarChar(64) // sha256 防重复登记（不做跨用户唯一）
  enabled               Boolean  @default(true)
  revision              Int      @default(0)
  currentBreakdownId    Int? // 当前生效 ChetaidouBreakdown.id
  activeBreakdownTaskId String?  @db.VarChar(36) // 拆解任务执行中占位
  importKey             String?  @unique @db.VarChar(191) // 导入命名空间幂等键
  sourceMetadata        Json? // 旧系统来源、原验收状态、历史提示词等审计
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([skuId, sourceType, ownerId, enabled, id])
}

/// 母版拆解，只追加版本；异步执行状态在 Task，不放这里
model ChetaidouBreakdown {
  id             Int       @id @default(autoincrement())
  imageId        Int
  version        Int
  factId         Int // 依据的 ChetaidouFactCard.id
  source         String    @db.VarChar(10) // PRESET（人工确认稿）/ AI（未预验收稿）
  qualityStatus  String    @db.VarChar(20) // CONFIRMED / AI_UNREVIEWED / INVALID
  payload        Json // elements/textInventory/persons/pets/baskets/hardConstraints/uncertainties
  schemaVersion  Int
  contentHash    String    @db.VarChar(64)
  confirmedBy    Int?
  confirmedAt    DateTime?
  importKey      String?   @unique @db.VarChar(191)
  sourceMetadata Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([imageId, version])
}

/// 个人草稿（每用户每图一份）；确认状态/任务指针只存这一处，所有写入 CAS revision
model ChetaidouDraft {
  id                       Int      @id @default(autoincrement())
  ownerId                  Int
  imageId                  Int
  revision                 Int      @default(0) // 乐观锁
  workspaceId              String?  @default(uuid()) @db.VarChar(36)
  activeAdjustmentId       String?  @db.VarChar(36)
  restoredFromAdjustmentId String?  @db.VarChar(36)
  settings                 Json // {site,textMode,personMode,personText,customText}
  selections               Json // [{groupId,optionKeys[],customText?}]
  customDimensions         Json // [{id,label,selectionMode,guidance,options[],selectedKeys[]}]
  acknowledgedBreakdownId  Int? // 用户已确认的拆解版本
  activeIdeationTaskId     String?  @db.VarChar(36) // 当前联想根任务
  activeCompositionTaskId  String?  @db.VarChar(36) // 当前组合根任务
  activeGroupRefs          Json? // 当前联想各组有序 {groupId} 引用（刷新只替换其一）
  pendingRefreshTaskId     String?  @db.VarChar(36) // 同草稿最多一个未终结刷新
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([ownerId, imageId])
}

/// 每用户每母版的调整历史；恢复后提交新任务分叉，不覆盖来源记录。
model ChetaidouAdjustment {
  id                 String   @id @default(uuid()) @db.VarChar(36)
  ownerId            Int
  skuId              Int
  imageId            Int
  parentAdjustmentId String?  @db.VarChar(36)
  state              Json
  schemaVersion      Int      @default(1)
  revision           Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([ownerId, imageId, createdAt, id])
  @@index([ownerId, skuId, createdAt, id])
}

/// 工作流任务（BREAKDOWN/IDEATION/REFRESH_GROUP/DIVERGE/COMPOSE 文本阶段；
/// GENERATE 只存命令与关联，执行状态由 ImageGenJob 投影）
model ChetaidouTask {
  id                    String    @id @default(uuid()) @db.VarChar(36)
  rootTaskId            String    @db.VarChar(36) // 根任务 rootTaskId=id
  parentTaskId          String?   @db.VarChar(36) // 问答轮次指向被回答的 COMPOSE 根任务
  retryOfTaskId         String?   @db.VarChar(36) // 失败重试指向原根任务
  imageGenJobId         String?   @db.VarChar(36) // GENERATE 关联 ImageGenJob.id
  ownerId               Int
  skuId                 Int
  imageId               Int
  workspaceId           String?   @db.VarChar(36)
  adjustmentId          String?   @db.VarChar(36)
  site                  String?   @db.VarChar(30)
  type                  String    @db.VarChar(20)
  operation             String    @default("PRIMARY") @db.VarChar(10) // PRIMARY / RETRY
  status                String?   @db.VarChar(32) // QUEUED/RUNNING/WAITING_RECONCILIATION/SUCCEEDED/PARTIAL/FAILED/CANCELLED；GENERATE 为 null（Job 投影）
  stage                 String?   @db.VarChar(64)
  idempotencyKey        String    @db.VarChar(36)
  requestHash           String    @db.VarChar(64) // 标准化请求 SHA-256；同键异 hash 409
  contextHash           String?   @db.VarChar(64) // 分阶段上下文指纹
  snapshot              Json // 完整冻结输入（image/facts/breakdown/settings/…）
  input                 Json // 本次命令入参
  output                Json? // COMPOSE 组合产物 / REFRESH 应用状态 / BREAKDOWN breakdownId
  progress              Json? // {total,processed,succeeded,failed}
  acceptedDraftRevision Int? // 提交时的草稿 revision
  appliedDraftRevision  Int? // 异步写回成功后的 revision
  appliedAt             DateTime?
  cancelRequestedAt     DateTime?
  errorCode             String?   @db.VarChar(64)
  errorMessage          String?   @db.VarChar(1000)
  finishedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([ownerId, idempotencyKey])
  @@index([status, createdAt])
  @@index([ownerId, createdAt, id])
  @@index([rootTaskId])
  @@index([imageGenJobId])
  @@index([parentTaskId])
  @@index([ownerId, imageId, type, createdAt])
  @@index([ownerId, skuId, site, createdAt, id])
  @@index([adjustmentId, createdAt, id])
}

/// 维度组（不可变版本：每次刷新分配新 groupId，成功行永不改写）
model ChetaidouGroup {
  id             String    @id @default(uuid()) @db.VarChar(36)
  taskId         String    @db.VarChar(36) // 产出该版本的根任务（IDEATION 或 REFRESH_GROUP）
  parentGroupId  String?   @db.VarChar(36) // 刷新产物指向被刷新的旧组
  key            String    @db.VarChar(100)
  definition     Json // targetElementId/attribute/selectionMode/kind/purpose/currentValue 等冻结元数据
  options        Json? // 30–60 项（刷新=保留项+新增项），含服务端分配的 selectionId
  status         String    @db.VarChar(20) // PENDING/RUNNING/SETTLING/SUCCEEDED/FAILED/CANCELLED/UNKNOWN
  currentCallId  String?   @db.VarChar(36)
  errorCode      String?   @db.VarChar(64)
  errorMessage   String?   @db.VarChar(1000)
  order          Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([taskId, key])
  @@index([taskId, order])
}

/// 逐次模型调用账本：识别/修复/每维扩展/组合检查/每张图各一行；执行恢复与费用对账的唯一事实源
model ChetaidouCall {
  id                      String    @id @default(uuid()) @db.VarChar(36)
  taskId                  String    @db.VarChar(36)
  rootTaskId              String    @db.VarChar(36)
  ownerId                 Int
  targetKey               String    @db.VarChar(100) // breakdown/identify/repair:identify/group:<id>/compose/image:<itemId>
  groupId                 String?   @db.VarChar(36)
  imageGenItemId          Int?
  attempt                 Int // 同任务同 targetKey 内新收费调用才递增
  kind                    String    @db.VarChar(10) // TEXT / IMAGE
  source                  String    @db.VarChar(50) // chetaidou.breakdown/ideation/diverge/compose/image
  model                   String    @db.VarChar(100)
  category                String?   @db.VarChar(50)
  promptVersion           String    @db.VarChar(100)
  request                 Json? // 最终供应商请求（发出前保存；含签名 URL 仅限受限读取）
  requestHash             String?   @db.VarChar(64)
  providerIdempotencyKey  String    @db.VarChar(100) // chetaidou:call:<callId>
  gatewayTaskId           String?   @unique @db.VarChar(191)
  gatewayRequestId        String?   @unique @db.VarChar(191)
  state                   String    @db.VarChar(20) // PREPARED/SUBMITTING/WAITING/RECEIVED/UNKNOWN/FINISHED
  outcome                 String?   @db.VarChar(20) // ACCEPTED/INVALID/PROVIDER_FAILED/CANCELLED/DELIVERY_FAILED
  billingStatus           String    @default("PENDING") @db.VarChar(20) // PENDING/SETTLED/FREE/REVIEW
  gatewayResponse         Json? // 受限原始回执（恢复时按冻结解析规则重校验）
  usage                   Json?
  estimatedSaleCny        Decimal   @default(0) @db.Decimal(18, 8)
  gatewayAmountCny        Decimal?  @db.Decimal(18, 8)
  pricing                 Json? // 首次结算定价快照（模式/模型/倍率/fixedCredits/时间）
  chargedCredits          Decimal?  @db.Decimal(18, 4)
  artifactFileKey         String?   @db.VarChar(1000)
  submittedAt             DateTime?
  receivedAt              DateTime?
  finishedAt              DateTime?
  errorCode               String?   @db.VarChar(64)
  errorMessage            String?   @db.VarChar(1000)
  resolution              Json? // 人工核对记录（操作人/凭据/原因/时间）
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([taskId, targetKey, attempt])
  @@unique([providerIdempotencyKey])
  @@index([state, createdAt])
  @@index([billingStatus, createdAt])
  @@index([rootTaskId])
  @@index([imageGenItemId])
}

/// 车泰斗结果导入成功记录；与目标记录同事务提交，不参与任务调度。
model ChetaidouResultImport {
  id             Int      @id @default(autoincrement())
  ownerId        Int
  idempotencyKey String   @db.VarChar(36)
  action         String   @db.VarChar(20)
  sourceResultId Int
  requestHash    String   @db.Char(64)
  response       Json
  createdAt      DateTime @default(now())

  @@unique([ownerId, idempotencyKey])
  @@index([ownerId, sourceResultId, action])
}
