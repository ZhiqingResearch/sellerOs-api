/// AI 模型模态，用于区分文本、图片和视频模型
enum AiModelModality {
  /// 文本生成模型
  TEXT
  /// 图片生成或编辑模型
  IMAGE
  /// 视频生成或编辑模型
  VIDEO
}

/// AI 模型执行方式
enum AiModelExecMode {
  /// 请求内同步返回结果
  SYNC
  /// 先返回任务，再异步查询结果
  ASYNC
}

/// 本项目使用的 AI Gateway 模型及类别配置
model AiGatewayModel {
  /// 数据库自增主键
  id              Int             @id @default(autoincrement())
  /// AI Gateway 对外提供的稳定模型 ID
  publicId        String          @db.VarChar(100)
  /// 本项目使用的模型类别，由业务自行定义
  category        String          @db.VarChar(50)
  /// AI Gateway 返回的模型展示名称
  displayName     String          @db.VarChar(200)
  /// 模型模态：TEXT、IMAGE 或 VIDEO
  modality        AiModelModality
  /// 模型执行方式：SYNC 或 ASYNC
  execMode        AiModelExecMode
  /// AI Gateway 模型能力、operation 及请求参数 Schema
  gatewayConfig   Json
  /// 模型定价配置
  quoteConfig     Json?
  /// 价格倍率：网关 usage 与报价统一乘以该倍率后计费/展示（视频 2、图片 3，TEXT 默认 1）
  priceMultiplier Decimal         @default(1) @db.Decimal(5, 2)
  /// 图片固定一口价（积分/张）：配置后该类别生图按「fixedCredits × 成功张数」精确扣费，
  /// 不应用折扣；AI_SPLIT 行为组合价（含拆图分析费）。NULL = 回落按量计费（网关账单 × priceMultiplier）。
  /// 扣费时实时读库，改库即时生效
  fixedCredits    Decimal?        @db.Decimal(8, 2)
  /// 模型当前是否仍在 AI Gateway 可用目录中
  gatewayActive   Boolean         @default(false)
  /// 最近一次成功同步模型基础信息的时间
  syncedAt        DateTime?
  /// 该模型在当前类别中是否启用
  enabled         Boolean         @default(false)
  /// 模型在当前类别列表中的展示顺序
  sortOrder       Int             @default(0)

  /// 记录创建时间
  createdAt DateTime @default(now())
  /// 记录最后更新时间
  updatedAt DateTime @updatedAt

  @@unique([publicId, category])
  @@index([modality, category, enabled, gatewayActive])
}

/// 视频模型一口价与展示成本：一行 = (publicId, category, mode, resolution) 一档价格，通过
/// publicId 关联 AiGatewayModel（同 publicId 可按业务类别分别定价，与其 publicId_category 唯一键同构）。
/// 配置后该档视频生成仅 SUCCESS 按「creditsPerSec × 实际时长秒」精确扣费（exactCredits，不打折不乘倍率；
/// 时长 0/缺失按 1 秒保底计）；无行/缺档 = 回落按量（网关账单 × priceMultiplier）。扣费时实时读库，改库即时生效。
/// mode = 网关请求的生成模式（reference_to_video / video_to_video 等），空串 = 通配该类别全部模式；
/// 匹配优先精确 mode 行，无命中再退通配行（同模型同分辨率可按模式配不同价）。
/// resolution = `flat` 为「按次一口价」档：带分辨率的请求未命中精确档时兜底命中（如动作复刻不分时长/
/// 分辨率一口价），SUCCESS 固定扣 creditsPerSec 一笔，不乘时长；精确档优先于 flat 档。
/// resolution = `adaptive` 为无分辨率自适应模型的保留兜底档（请求/终态均无 resolution 时才命中），
/// 该档同为「按次一口价」语义：SUCCESS 固定扣 creditsPerSec 一笔，不乘时长
model AiGatewayVideoFixedPrice {
  /// 数据库自增主键
  id            Int     @id @default(autoincrement())
  /// 关联 AiGatewayModel.publicId
  publicId      String  @db.VarChar(100)
  /// 业务类别：NORMAL（常规模式）/ REFERENCE（全能参考）/ MOTION_CONTROL / STORYBOARD / BEAUTY 等
  category      String  @db.VarChar(50)
  /// 生成模式（小写归一存储）：网关请求 mode 原值（如 reference_to_video / video_to_video）；空串 = 通配
  mode          String  @default("") @db.VarChar(50)
  /// 分辨率档（小写归一存储）：360p / 480p / 720p / 720p-sr / 1080p / 1080p-sr / 1440p-sr
  resolution    String  @db.VarChar(50)
  /// 固定一口价：积分/秒（>0）；NULL = 按网关实际账单计费，成本字段不参与扣费
  creditsPerSec Decimal? @db.Decimal(8, 2)
  /// 预估成本下限/上限（人民币）；固定成本两者相同，必须成对配置。
  /// costPerRequest=false 为元/秒，true 为元/次。仅用于展示报价。
  costMinCny    Decimal? @db.Decimal(12, 6)
  costMaxCny    Decimal? @db.Decimal(12, 6)
  /// 按次展示成本，可为不同分辨率独立配置，不影响一口价扣费。
  costPerRequest Boolean @default(false)

  /// 记录创建时间
  createdAt DateTime @default(now())
  /// 记录最后更新时间
  updatedAt DateTime @updatedAt

  @@unique([publicId, category, mode, resolution])
  @@index([publicId, category])
}

// 用量定价配置（支持后台管理调整）
