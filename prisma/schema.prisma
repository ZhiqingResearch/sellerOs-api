  credits          Decimal?  @db.Decimal(18, 4) // 本次实扣积分（含折扣）；积分看板按此聚合，旧数据为 null
  balanceAfter     Decimal   @db.Decimal(12, 4) // 扣后积分余额
  source           String?   @db.VarChar(100)
