generator client {
  provider = "prisma-client-js"
}

// 类目分析任务：请求幂等、结果按用户隔离；逻辑 userId 沿用 User 的 Int 类型。
model CategoryAnalysisRecord {
  id             Int       @id @default(autoincrement()) @db.UnsignedInt // 任务主键
  userId         Int // 所属用户，逻辑外键
  requestId      String    @db.VarChar(36) // 客户端请求幂等键
  fingerprint    String    @db.VarChar(64) // 请求摘要，防同键不同请求
  marketplace    String    @db.VarChar(10) // Amazon 站点
  title          String    @db.VarChar(500) // 类目名称摘要
  categories     Json // 选择的 0–5 个类目快照
  keywords       Json? // 用户输入的英文关键词，最多 5 个
  plan           String    @default("cat") @db.VarChar(10) // cat 类目 / kw 关键词 / mix 交集
  resolution     Json? // 关键词反查候选与用户确认快照
  status         String    @default("PENDING") @db.VarChar(20) // PENDING / PROCESSING / AWAITING_SELECTION / COMPLETED / FAILED
  leaseToken     String?   @db.VarChar(36) // 任务认领令牌
  leaseExpiresAt DateTime? // 任务租约，过期标失败而不重复消耗外部配额
  error          String?   @db.VarChar(500) // 中文失败原因
  credits        Decimal   @default(0) @db.Decimal(12, 4) // 实际 AI 账单累计实扣积分（旧固定费退款后为零）
  result         Json? // 六节结构化报告及标准化 Markdown
  createdAt      DateTime  @default(now()) // 创建时间
  updatedAt      DateTime  @updatedAt // 更新时间
  deletedAt      DateTime? // 软删除，保留计费幂等记录

  @@unique([userId, requestId])
  @@index([userId, deletedAt, createdAt])
  @@index([status, leaseExpiresAt])
}

// 公共市场数据缓存（SIF 14 天、Keepa 当天）；跨刷新和重启复用，不含用户报告或凭证。
model CategoryAnalysisCache {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt // 缓存主键
  cacheKey  String   @unique @db.VarChar(64) // 请求键 SHA256
  payload   Json // 第三方成功响应
  expiresAt DateTime // 按数据源策略保存固定到期时间，读取不续期
  createdAt DateTime @default(now()) // 创建时间
  updatedAt DateTime @updatedAt // 更新时间

  @@index([expiresAt])
}

// 样本解析入口按文档保留为 API，不在页面恢复数据源面板。
model CategoryAnalysisSample {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt // 样本主键
  userId      Int // 用户隔离，与 User.id 类型一致
  categoryId  String   @db.VarChar(100) // 类目节点
  marketplace String   @db.VarChar(10) // 站点
  month       String   @db.VarChar(7) // yyyy-MM
  rows        Json // 已去重、归一化的样本行
  createdAt   DateTime @default(now()) // 导入时间
  updatedAt   DateTime @updatedAt // 更新时间

  @@unique([userId, categoryId, marketplace, month])
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                       Int                       @id @default(autoincrement())
  username                 String
  phone                    String                    @unique
  email                    String?                   @db.VarChar(120) // 账号通知邮件投递地址
  receiptEmail             String?                   @db.VarChar(100) // 默认收据接收邮箱（收据中心可改；空=用账号 email）
  password                 String
  balance                  Decimal                   @default(720) @db.Decimal(12, 4)
  totalSpent               Decimal                   @default(0) @db.Decimal(12, 4)
  modelUnlocked            Boolean                   @default(false)
  isActive                 Boolean                   @default(true)
  deactivatedAt            DateTime?
  lastLoginAt              DateTime?
  mustChangePassword       Boolean                   @default(false)
  // 会员 / 积分体系（等级由订阅 + 邀请身份推导，与积分余额无关）
  membershipLevel          MembershipLevel           @default(NONE) // 冗余当前等级，订阅/邀请变更时回写
  subscriptionTier         Int? // 1/2/3，过期不清（保留等级）
  subscriptionStart        DateTime?
  subscriptionExpiresAt    DateTime? // 过期只影响「升级 vs 续费」判定
  canInvite                Boolean                   @default(false) // true = 分销代理（可邀请、计返利；不再切等级）
  discount                 Decimal                   @default(1) @db.Decimal(4, 3) // 0.5~1.0 消费折扣（邀请人及其被邀请人）
  rebateRate               Decimal                   @default(0.30) @db.Decimal(4, 3) // 一级返利比例（开启邀请后生效）
  invitedById              Int? // 邀请人；审批通过建号时写入（仅关系，不再带 LV4 等级）
  inviteCode               String?                   @unique @db.VarChar(32)
  inviteCodeExpiresAt      DateTime? // 邀请码 24h 有效
  canRecharge              Boolean                   @default(false) // 后台充值操作员白名单（账号级，连超管也需显式开）
  shareCreditsWithInvitees Boolean                   @default(false) // LV5：开启后其下级可在自身额度外继续消耗本邀请人额度（仅 canRecharge 运营可改）
  inviteQuota              Int? // 邀请名额（null=不限）；approve 成功计 1
  subInviteAllowed         Boolean                   @default(false) // 下级可继续邀请；打开时批量打开一级下级邀请权（2026-09-01 起落库制）
  canInviteManualOff       Boolean                   @default(false) // 邀请权被人工单独关闭（2026-09-01）：上级批量打开时跳过；批量收回/单独再开时清除
  corpPassUp               Boolean? // 进企业后仍计返利（企业池段，2026-08-31）：null=跟随全局 RebateRule.corpCounts；逐人设定优先于全局
  rebateEnabled            Boolean                   @default(true) // 参与返利计划
  level2RebateRate         Decimal?                  @db.Decimal(4, 3) // 默认二级返利比例（null 用全局默认 0.10）
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  roles                    UserRole[]
  orgs                     UserOrganization[]
  histories                History[]
  productReports           ProductReport[]
  selectedProducts         SelectedProduct[]
  selectionAnalyses        SelectionAnalysisRecord[]
  productLibraryItems      ProductLibraryItem[]
  asinAuditRecords         AsinAuditRecord[]
  asinEvidenceRecords      AsinEvidenceRecord[]
  smartPricingRecords      SmartPricingRecord[]

  promotionPlanRecords      PromotionPlanRecord[]
  competitorAnalysisRecords CompetitorAnalysisRecord[]
  videoAnalysisRecords      VideoAnalysisRecord[]
  businessAiRuns            BusinessAiRun[]
  usageLogs                 UsageLog[]
  customers                 Customer[]
  crawlLogs                 CrawlLog[]
  imageProjects             ImageProject[]
  productPublishTasks       ProductPublishTask[]
  imageTasks                GenerationTask[]
  imageGenJobs              ImageGenJob[]
  imageTemplates            ImageTemplate[]
  imageTemplateGroups       ImageTemplateGroup[]
  brandKits                 BrandKit[]
  sensitiveWords            SensitiveWord[]
  announcements             Announcement[]
  videoProjects             VideoProject[]
  videoTasks                VideoTask[]
  rpaCreationProjects       RpaCreationProject[]
  rpaCreationTasks          RpaCreationTask[]
  beautyProjects            BeautyProject[]
  beautyTasks               BeautyTask[]
  salesWorkflows            SalesWorkflow[]
  poolImages                PoolImage[]
  poolGroups                PoolGroup[]
  digitalHumans             DigitalHuman[]
  scenes                    Scene[]
  inspirationSubscriptions  InspirationSubscription[]
  adCleaningTasks           AdCleaningTask[]
  invitedBy                 User?                      @relation("UserInvites", fields: [invitedById], references: [id])
  invitees                  User[]                     @relation("UserInvites")
  inviteApplications        InviteApplication[]
  creditLots                CreditLot[]
  creditTxns                CreditTransaction[]
  scheduledPlans            ScheduledPlan[]
  billingOrders             BillingOrder[]
  receipts                  Receipt[]
  teamsAdmin                Team[]                     @relation("TeamAdmin")
  teamMemberships           TeamMember[]
  skillMarketUserSkills     SkillMarketUserSkill[]
  emailAccounts             EmailAccount[]
  skillsKeyCredentials      SkillsKeyCredential[]
}

/// 广告数据清洗任务状态
enum AdCleaningTaskStatus {
  /// 已创建，正在等待 Worker 处理
  PENDING
  /// Worker 正在读取、清洗或上传结果
  PROCESSING
  /// 清洗结果已成功上传到文件服务器
  SUCCESS
  /// 文件校验、清洗或上传失败
  FAILED
}

/// 广告数据清洗任务；只保存任务元数据和清洗结果 URL，不保存原始或清洗后的逐行广告数据
model AdCleaningTask {
  /// 数据库自增主键，仅供内部关联使用
  id     Int    @id @default(autoincrement())
  /// 对外暴露的任务 UUID
  taskId String @unique @default(uuid()) @db.VarChar(36)
  /// 创建任务的用户 ID，从 JWT 获取
  userId Int
  /// 创建任务的用户
  user   User   @relation(fields: [userId], references: [id])

  /// 任务状态：PENDING / PROCESSING / SUCCESS / FAILED
  status   AdCleaningTaskStatus @default(PENDING)
  /// 前端展示进度，范围 0～100
  progress Int                  @default(0)
  /// 当前处理阶段或简短状态说明
  stage    String               @default("等待处理") @db.VarChar(100)

  /// 用户上传的原始文件名，仅用于任务展示和生成结果文件名
  originalFilename String  @db.VarChar(500)
  /// 清洗结果上传到文件服务器后返回的稳定 URL；成功前为空
  resultFileUrl    String? @db.VarChar(1000)

  /// 失败原因；成功任务为空
  errorMessage String?   @db.Text
  /// Worker 实际开始处理时间
  startedAt    DateTime?
  /// 成功或失败的完成时间
  completedAt  DateTime?

  /// 任务创建时间
  createdAt DateTime @default(now())
  /// 任务最后更新时间
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([status, createdAt])
}

model SmsCode {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String
  used      Boolean  @default(false)
  attempts  Int      @default(0) // 错码累计5次后不可核销
  expiredAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
}

// 视频分析成功结果快照；软删除保留请求幂等键，不删除计费流水。
model VideoAnalysisRecord {
  id              String    @id @default(uuid()) @db.VarChar(36)
  userId          Int
  user            User      @relation(fields: [userId], references: [id])
  chargeRequestId String    @db.VarChar(191)
  fingerprint     String    @db.VarChar(64)
  title           String    @db.VarChar(500)
  videoUrl        String    @db.Text
  duration        Float
  focus           String?   @db.Text
  mimeType        String    @db.VarChar(191)
  model           String    @db.VarChar(191)
  result          Json
  usage           Json
  usageDetail     Json
  charge          Json
  createdAt       DateTime  @default(now())
  deletedAt       DateTime?

  @@unique([userId, chargeRequestId])
  @@index([userId, deletedAt, createdAt])
}

model History {
  id         Int               @id @default(autoincrement())
  title      String            @db.VarChar(500)
  type       HistoryType
  score      Float?
  data       Json
  version    Int               @default(1) // 当前 data 版本号 = max(revisions.version)
  userId     Int
  user       User              @relation(fields: [userId], references: [id])
  revisions  HistoryRevision[]
  listingRun ListingRun? // 仅 ORM 反向关联，不增加 History 数据库列
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([userId])
}

// History.data 的历史版本快照（仅 data 参与版本化；title/score 为当前元数据，不留档）
model HistoryRevision {
  id        Int      @id @default(autoincrement())
  historyId Int
  history   History  @relation(fields: [historyId], references: [id], onDelete: Cascade)
  version   Int // 该 History 内自增 1..N
  data      Json // 该版本的 data 快照
  createdAt DateTime @default(now())

  @@unique([historyId, version])
  @@index([historyId])
}

// Listing 工作流状态独立于公共报告及其版本；创建任务时原子建立 History。
model ListingRun {
  id          Int                     @id @default(autoincrement()) @db.UnsignedInt // 主键
  runId       String                  @unique @db.VarChar(36) // 客户端工作流 UUID，幂等创建键
  historyId   Int                     @unique // 对应通用报告，兼容 History 的有符号主键；归属用户从报告读取
  history     History                 @relation(fields: [historyId], references: [id], onDelete: Restrict) // 保留任务与报告的关联证据
  status      String                  @default("ANALYZING") @db.VarChar(24) // ANALYZING / RUNNING / COMPLETED / FAILED
  stage       String                  @default("preparation") @db.VarChar(50) // 当前业务步骤
  error       String?                 @db.VarChar(1000) // 失败原因，不存凭证
  attempts    Json? // A/B 方案各次生成状态，不与可编辑报告混存
  steps       ListingAiStep[] // 任务的模型调用步骤
  generations ListingGenerationTask[] // 可恢复的主生成任务，不依赖浏览器连接
  createdAt   DateTime                @default(now()) // 创建时间
  updatedAt   DateTime                @updatedAt // 最近状态更新时间
}

// 每次模型调用先建步骤；输出与公共 UsageLog 扣费在同一事务提交，不另存一份积分。
model ListingAiStep {
  id           Int        @id @default(autoincrement()) @db.UnsignedInt // 主键
  listingRunId Int        @db.UnsignedInt // 所属 ListingRun 的主键
  listingRun   ListingRun @relation(fields: [listingRunId], references: [id], onDelete: Restrict) // 不级联删除调用证据
  operation    String     @db.VarChar(50) // category_match / attribute_analysis / long_title / generation / optimization / qa_rewrite / score
  model        String     @db.VarChar(100) // 实际调用模型
  status       String     @default("RUNNING") @db.VarChar(24) // RUNNING / COMPLETED / FAILED
  usageLogId   Int?       @unique // 逻辑关联公共 UsageLog，避免在计费热表增加外键；同事务写入，费用以台账为准
  requestId    String?    @db.VarChar(200) // 网关请求 ID
  outputText   String?    @db.LongText // 原始模型正文，用于失败排查与结果恢复，不在列表中返回
  error        String?    @db.VarChar(1000) // 失败原因
  createdAt    DateTime   @default(now()) // 开始时间
  updatedAt    DateTime   @updatedAt // 最近更新时间

  @@index([listingRunId, createdAt])
}

// 主生成先保存模型响应，平台规则校验完成后才原子保存报告与扣费。
model ListingGenerationTask {
  id              Int        @id @default(autoincrement()) @db.UnsignedInt // 主键
  attemptId       String     @unique @db.VarChar(36) // 同一次提交幂等键
  listingRunId    Int        @db.UnsignedInt // 所属工作流
  listingRun      ListingRun @relation(fields: [listingRunId], references: [id], onDelete: Restrict)
  planIndex       Int        @db.UnsignedTinyInt // 0=A，1=B
  status          String     @default("QUEUED") @db.VarChar(24) // QUEUED/RUNNING/READY/COMPLETED/PARTIAL/FAILED
  input           Json // Prompt 和平台规则上下文快照，不存用户凭证
  mainStepId      Int        @unique @db.UnsignedInt // 逻辑关联 ListingAiStep，原始正文只存一份
  longTitleStepId Int?       @unique @db.UnsignedInt // 可选长标题调用步骤
  billing         Json? // 服务端写入的网关账单快照，仅用于原事务恢复，不对页面下发
  isModelComplete Boolean    @default(false) // 完整收到正文及网关终态；截断内容不能标为成功
  leaseUntil      DateTime? // 多实例运行租约，过期仅恢复已有正文，不再次调用模型
  error           String?    @db.VarChar(1000) // 失败原因
  createdAt       DateTime   @default(now()) // 创建时间
  updatedAt       DateTime   @updatedAt // 更新时间

  @@index([status, leaseUntil])
  @@index([listingRunId, createdAt])
}

/// 运营工具 AI 运行证据：模型一旦完成即保存原始正文，页面断线后按 runId 读取，不重复调用模型。
model BusinessAiRun {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt // 主键
  userId     Int // 所属用户，与现有 User.id 类型保持一致
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict) // 调用证据不可随用户误删
  runId      String   @db.VarChar(100) // 页面生成的稳定运行号，同一操作重试复用
  module     String   @db.VarChar(50) // promotion-plan / smart-pricing / competitor-analysis
  operation  String   @db.VarChar(50) // generate / extract / research / summary
  model      String   @db.VarChar(100) // 实际选择的模型
  inputHash  String   @db.Char(64) // systemPrompt + userPrompt 指纹，防止幂等号误复用
  status     String   @default("RUNNING") @db.VarChar(24) // RUNNING / COMPLETED / FAILED
  requestId  String?  @db.VarChar(200) // AI 中转站请求 ID
  usageLogId Int?     @unique // 逻辑关联公共 UsageLog，费用仍以积分台账为准
  outputText String?  @db.LongText // 完整原始模型正文，供解析失败或断线恢复
  billing    Json? // 网关账单终态快照，仅用于服务端恢复结算，不对页面下发
  error      String?  @db.VarChar(1000) // 失败原因，不保存凭证
  createdAt  DateTime @default(now()) // 创建时间
  updatedAt  DateTime @updatedAt // 更新时间

  @@unique([userId, module, operation, runId])
  @@index([userId, module, createdAt])
  @@index([status, updatedAt])
}

model ProductReport {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(500)
  score       Float?
  description String?  @db.Text
  data        Json
  reportUrl   String?  @db.VarChar(1000)
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model SelectedProduct {
  id          Int      @id @default(autoincrement())
  productCode String
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  @@index([userId])
}

/// 选品分析入口
enum SelectionAnalysisEntry {
  /// 逛类目找机会
  CATALOG
  /// 验证单个商品
  PRODUCT
}

/// 选品分析流程状态
enum SelectionAnalysisStatus {
  /// 当前入口的分析流程尚未完成
  PROCESSING
  /// 当前入口的分析流程已完成
  COMPLETED
}

/// 五步选品分析的步骤类型
enum SelectionAnalysisStepType {
  /// 第1步：类目机会诊断
  CATEGORY_DIAGNOSIS
  /// 第2步：赛道验证
  TRACK_VALIDATION
  /// 第3步：产品验证与竞品池
  COMPETITOR_POOL
  /// 第4步：流量与广告验证
  TRAFFIC_AD_VALIDATION
  /// 第5步：最终产品清单
  PRODUCT_LIST
  /// 产品验证入口：单步最终结果
  PRODUCT_VALIDATION
}

/// 选品分析主记录：CATALOG 为五步，PRODUCT 为单步
model SelectionAnalysisRecord {
  /// 分析记录ID，UUID格式
  id                    String                   @id @default(uuid()) @db.VarChar(36)
  /// 所属用户ID，从JWT获取
  userId                Int
  /// 所属用户
  user                  User                     @relation(fields: [userId], references: [id])
  /// 前端创建请求唯一ID，用于避免网络重试产生重复分析
  clientRequestId       String                   @db.VarChar(64)
  /// 创建请求规范化内容的SHA-256指纹，用于识别幂等键误复用
  createFingerprint     String                   @db.VarChar(64)
  /// 电商站点代码，例如US、UK、DE、JP
  marketplace           String                   @db.VarChar(16)
  /// 分析入口，默认逛类目
  entry                 SelectionAnalysisEntry   @default(CATALOG)
  /// 主类目节点ID
  primaryCategoryNodeId String?                  @db.VarChar(255)
  /// 主类目完整路径，用于列表展示和搜索
  primaryCategoryPath   String?                  @db.VarChar(1000)
  /// 主类目名称，优先保存中文名
  primaryCategoryName   String?                  @db.VarChar(500)
  /// 本次分析选择的全部类目上下文JSON
  categories            Json
  /// 当前有效的最高已完成步骤，范围1到5
  lastCompletedStep     Int                      @default(1)
  /// 最终商品数量；PRODUCT 完成时为1，未完成时为0
  pickCount             Int                      @default(0)
  /// 当前分析状态
  status                SelectionAnalysisStatus  @default(PROCESSING)
  /// 主记录乐观锁版本，每次有效步骤变更递增
  version               Int                      @default(1)
  /// 创建时间
  createdAt             DateTime                 @default(now())
  /// 最后更新时间
  updatedAt             DateTime                 @updatedAt
  /// 软删除时间，NULL表示未删除
  deletedAt             DateTime?
  /// 当前有效的分步结果
  steps                 SelectionAnalysisStep[]
  /// 从该分析存入商品库的画像快照
  productSnapshots      ProductLibrarySnapshot[]

  /// 同一用户的同一个创建请求只能对应一条分析记录
  @@unique([userId, clientRequestId])
  /// 当前用户分析记录列表按更新时间查询
  @@index([userId, deletedAt, updatedAt])
  /// 当前用户按站点筛选分析记录
  @@index([userId, marketplace, deletedAt, updatedAt], map: "SelectionAnalysisRecord_user_marketplace_updated_idx")
}

/// 选品分析分步结果：每个分析的每个步骤只保留一条当前有效记录
model SelectionAnalysisStep {
  /// 步骤记录自增主键
  id            Int                       @id @default(autoincrement())
  /// 所属分析记录ID
  analysisId    String                    @db.VarChar(36)
  /// 所属分析；物理删除分析时级联删除步骤
  analysis      SelectionAnalysisRecord   @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  /// 步骤编号，范围1到5
  stepNo        Int
  /// 步骤业务类型
  stepType      SelectionAnalysisStepType
  /// 当前步骤payload的数据结构版本
  schemaVersion Int                       @default(1)
  /// 当前步骤完整结果JSON，不包含其他步骤数据
  payload       Json
  /// 规范化payload的SHA-256哈希，用于内容幂等
  payloadHash   String                    @db.VarChar(64)
  /// 当前步骤内容修订版本，实际变化时递增
  revision      Int                       @default(1)
  /// 首次保存时间
  createdAt     DateTime                  @default(now())
  /// 最后更新时间
  updatedAt     DateTime                  @updatedAt

  /// 每次分析的每个步骤只保留一条当前有效结果
  @@unique([analysisId, stepNo])
  /// 按分析ID加载全部步骤
  @@index([analysisId])
}

/// 智能定价历史快照：前端完成定价后一次性归档，后端不重新计算报告
model SmartPricingRecord {
  /// 对外暴露的记录 UUID
  id                String    @id @default(uuid()) @db.VarChar(36)
  /// 所属用户 ID，从 JWT 获取
  userId            Int
  user              User      @relation(fields: [userId], references: [id])
  /// 前端创建请求 UUID，用于创建幂等
  clientRequestId   String    @db.VarChar(64)
  /// 规范化创建内容的 SHA-256 指纹
  createFingerprint String    @db.VarChar(64)
  /// 快照数据结构版本
  schemaVersion     Int       @default(1)
  /// 唯一且稳定的站点代码，例如 AMAZON_US
  marketplaceCode   String    @db.VarChar(32)
  /// 归档时的站点展示名称，例如 Amazon US
  marketplaceName   String    @db.VarChar(64)
  /// 当前固定为 USD
  currency          String    @db.Char(3)
  /// 商品类目展示名称
  category          String    @db.VarChar(255)
  /// 列表摘要：商品名称
  productName       String    @db.VarChar(500)
  /// 列表摘要：建议售价
  suggestedPrice    Decimal   @db.Decimal(18, 6)
  /// 列表摘要：净利率，按百分数保存
  netMargin         Decimal   @db.Decimal(12, 6)
  /// 列表摘要：单件净利
  netProfit         Decimal   @db.Decimal(18, 6)
  /// 列表摘要：保本价
  floorPrice        Decimal   @db.Decimal(18, 6)
  /// 列表摘要：综合评分
  compositeScore    Decimal   @db.Decimal(7, 4)
  /// 列表摘要：结论文案
  verdictText       String    @db.VarChar(255)
  /// 完整产品输入快照
  product           Json
  /// 完整定价输入快照；API 响应映射为 input
  inputSnapshot     Json
  /// 竞品上下文；竞品查询失败时为 NULL
  competitorContext Json?
  /// 完整定价结果快照
  result            Json
  /// 记录版本，创建时为 1，软删除时递增
  version           Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  @@unique([userId, clientRequestId])
  @@index([userId, deletedAt, createdAt])
  @@index([userId, marketplaceCode, deletedAt, createdAt], map: "SmartPricingRecord_user_market_created_idx")
  @@index([userId, category, deletedAt, createdAt], map: "SmartPricingRecord_user_category_created_idx")
}

/// 新品推广计划 · 历史记录（只读快照，无更新语义）
model PromotionPlanRecord {
  /// 对外暴露的记录 UUID
  id              String @id @default(uuid()) @db.VarChar(36)
  /// 归属用户 ID，从 JWT 获取
  userId          Int
  user            User   @relation(fields: [userId], references: [id])
  /// 幂等键，前端每次生成成功时 crypto.randomUUID() 生成
  clientRequestId String @unique @db.VarChar(36)
  /// 快照结构版本，当前恒为 1
  schemaVersion   Int    @default(1)
  /// 乐观锁版本，当前恒为 1（预留，无更新接口）
  version         Int    @default(1)

  /// 列表展示名 + 关键词搜索（取 result.productName）
  productName     String @db.VarChar(200)
  /// Market 枚举值（DTO 层校验，DB 存 string 以便扩展新站点）
  market          String @db.VarChar(32)
  /// 类目中文名（前端预设 11 选 1，透传存储）
  category        String @db.VarChar(64)
  /// 锚点常规价（冗余列，取 result.anchorPrice，列表摘要用）
  anchorPrice     Float?
  /// 竞品对标数（冗余列，取 input.competitors.length）
  competitorCount Int    @default(0)

  /// 生成时表单输入快照
  input  Json
  /// SopResult 全量（不透明 JSON 存储，仅强校验 productName）
  result Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
}

enum CompetitorAnalysisMode {
  ASIN
  KEYWORD
}

/// 竞品分析历史主记录：保存总体结果、最终报告和列表摘要
model CompetitorAnalysisRecord {
  id                 String                      @id @default(uuid()) @db.VarChar(36)
  userId             Int
  user               User                        @relation(fields: [userId], references: [id], onDelete: Restrict)
  clientRequestId    String                      @db.VarChar(36)
  createFingerprint  String                      @db.Char(64)
  schemaVersion      Int                         @default(1)
  marketplace        String                      @db.VarChar(16)
  mode               CompetitorAnalysisMode
  ownAsin            String?                     @db.Char(10)
  competitorAsins    Json
  sourceKeyword      String?                     @db.VarChar(500)
  title              String                      @db.VarChar(500)
  productCount       Int
  competitorCount    Int
  inputSnapshot      Json
  analysisResult     Json
  reportData         Json
  reportPdfUrl       String?                     @db.VarChar(2048)
  reportPdfUpdatedAt DateTime?
  payloadBytes       Int
  version            Int                         @default(1)
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  deletedAt          DateTime?
  products           CompetitorAnalysisProduct[]

  @@unique([userId, clientRequestId])
  @@index([userId, deletedAt, createdAt])
  @@index([userId, marketplace, deletedAt, createdAt], map: "CompetitorAnalysisRecord_user_market_created_idx")
  @@index([userId, ownAsin, deletedAt, createdAt], map: "CompetitorAnalysisRecord_user_own_asin_created_idx")
}

/// 一次竞品分析中的单个产品；productData 按前端传入内容原样保存
model CompetitorAnalysisProduct {
  id          Int                             @id @default(autoincrement())
  recordId    String                          @db.VarChar(36)
  record      CompetitorAnalysisRecord        @relation(fields: [recordId], references: [id], onDelete: Cascade)
  asin        String                          @db.Char(10)
  sortOrder   Int
  productData Json
  steps       CompetitorAnalysisProductStep[]
  createdAt   DateTime                        @default(now())
  updatedAt   DateTime                        @updatedAt

  @@unique([recordId, asin])
  @@unique([recordId, sortOrder])
  @@index([asin, recordId], map: "CompetitorAnalysisProduct_asin_record_idx")
}

/// 单个产品的一步分析结果；步骤类型和数量由前端决定
model CompetitorAnalysisProductStep {
  id            Int                       @id @default(autoincrement())
  productId     Int
  product       CompetitorAnalysisProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  stepCode      String                    @db.VarChar(64)
  stepNo        Int
  schemaVersion Int                       @default(1)
  resultData    Json
  payloadHash   String                    @db.Char(64)
  payloadBytes  Int
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@unique([productId, stepCode])
  @@unique([productId, stepNo])
}

/// 用户商品库主表：同一用户、站点和ASIN只保存一条商品
model ProductLibraryItem {
  /// 商品库记录自增主键
  id                 Int                      @id @default(autoincrement())
  /// 所属用户ID，从JWT获取
  userId             Int
  /// 所属用户
  user               User                     @relation(fields: [userId], references: [id])
  /// 电商站点代码，例如US、UK、DE、JP
  marketplace        String                   @db.VarChar(16)
  /// Amazon ASIN；可选，传入时统一转大写
  asin               String?                  @db.VarChar(32)
  /// 商品标题
  title              String?                  @db.VarChar(1000)
  /// 品牌名称
  brand              String?                  @db.VarChar(255)
  /// 商品主图URL
  imageUrl           String?                  @db.VarChar(2048)
  /// 用户标签字符串数组
  tags               Json?
  /// 用户备注
  notes              String?                  @db.Text
  /// 最新一次画像的主攻关键词
  latestKeyword      String?                  @db.VarChar(500)
  /// 最新一次画像的竞品综合评分，用于列表排序
  latestCompScore    Decimal?                 @db.Decimal(10, 4)
  /// 最新一次画像的商品价格
  latestPrice        Decimal?                 @db.Decimal(12, 2)
  /// 最新一次画像的月销量
  latestMonthlySales Int?
  /// 最新一次画像的评论数量
  latestRatingNum    Int?
  /// 首次入库时间
  createdAt          DateTime                 @default(now())
  /// 最后更新时间
  updatedAt          DateTime                 @updatedAt
  /// 软删除时间，NULL表示未删除
  deletedAt          DateTime?
  /// 该商品的不同来源画像快照
  snapshots          ProductLibrarySnapshot[]

  /// 有 ASIN 时，同一用户、站点和ASIN在商品库中只有一条主记录；NULL 不参与去重
  @@unique([userId, marketplace, asin])
  /// 当前用户商品库列表按更新时间查询
  @@index([userId, deletedAt, updatedAt])
  /// 当前用户按站点和最新评分筛选、排序
  @@index([userId, marketplace, deletedAt, latestCompScore], map: "ProductLibraryItem_user_marketplace_score_idx")
}

/// 商品库来源画像快照：保留同一商品在不同分析和关键词下的完整画像
model ProductLibrarySnapshot {
  /// 商品画像快照自增主键
  id               Int                     @id @default(autoincrement())
  /// 所属商品库主记录ID
  itemId           Int
  /// 所属商品；物理删除商品时级联删除画像
  item             ProductLibraryItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// 来源选品分析记录ID
  sourceAnalysisId String                  @db.VarChar(36)
  /// 来源分析；存在画像时禁止物理删除来源分析
  sourceAnalysis   SelectionAnalysisRecord @relation(fields: [sourceAnalysisId], references: [id], onDelete: Restrict)
  /// 该画像对应的主攻关键词
  keyword          String                  @db.VarChar(500)
  /// 该次分析的竞品综合评分
  compScore        Decimal?                @db.Decimal(10, 4)
  /// 该次分析的商品价格
  price            Decimal?                @db.Decimal(12, 2)
  /// 该次分析的月销量
  monthlySales     Int?
  /// 该次分析的评论数量
  ratingNum        Int?
  /// 来源分析中的完整商品画像JSON快照
  profile          Json
  /// 画像及摘要字段的SHA-256哈希，用于入库幂等
  profileHash      String                  @db.VarChar(64)
  /// 画像首次入库时间
  createdAt        DateTime                @default(now())
  /// 画像最后更新时间
  updatedAt        DateTime                @updatedAt

  /// 同一商品、来源分析和关键词只保留一份画像
  @@unique([itemId, sourceAnalysisId, keyword])
  /// 按来源分析查询已入库画像
  @@index([sourceAnalysisId])
  /// 按商品查询画像并按更新时间排序
  @@index([itemId, updatedAt])
}

enum HistoryType {
  PRODUCT_SCORING
  LISTING_GENERATION
  LISTING_SCORING
  ADMIN_ACTION // 后台敏感操作审计（如查看用户手机号全号）
}

enum TagCategory {
  INDUSTRY // 所属行业
  PLATFORM // 运营平台
  ACCOUNT_STYLE // 账号风格
}

// 标签表
model Tag {
  id       Int         @id @default(autoincrement())
  name     String // 标签名称
  category TagCategory // 分类

  createdAt DateTime @default(now())

  @@unique([name, category])
}

// 客户表
model Customer {
  id             Int     @id @default(autoincrement())
  name           String // 客户名称
  industry       Json // 所属行业（多选）["美容护肤", "母婴"]
  contentFocus   String // 内容方向
  platforms      Json // 运营平台 ["小红书", "抖音"]
  targetAudience String? // 目标受众
  marketingGoals String? // 运营目标
  contentTone    String? // 内容调性
  avoidTopics    String? // 规避方向
  strategy       String? @db.Text // AI生成的运营方案（Markdown）

  userId Int // 所属用户（创建者）
  user   User @relation(fields: [userId], references: [id])

  accounts Account[]
  avatars  Avatar[]
  voices   Voice[]
  projects Project[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId])
}

// 账号表
model Account {
  id                Int     @id @default(autoincrement())
  name              String // 账号名称
  platform          String // 平台
  accountStyle      String? // 账号风格（单选，选填）
  coreKeywords      Json // 核心关键词 ["抗衰", "成分党"]
  targetPositioning String? // 目标定位
  strategy          String? @db.Text // AI生成的账号规划方案（Markdown）

  customerId Int
  customer   Customer  @relation(fields: [customerId], references: [id])
  projects   Project[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// 形象表
// kind = CLONED：客户私有克隆形象（曦灵训练），trainingUrl/thumbnailUrl/status 走训练状态机
// kind = PUBLIC：客户从"公共形象库"添加的引用（figureId 指向 PublicAvatar），创建时 status=SUCCESS
//                 详情字段（templateImg/templateVideoUrl/pose/background 等）读时 LEFT JOIN PublicAvatar 补全
model Avatar {
  id           Int      @id @default(autoincrement())
  name         String // 形象名称
  gender       String   @default("FEMALE") // 性别: MALE / FEMALE
  description  String? // 形象描述
  trainingUrl  String? // 训练文件 URL（PUBLIC 行为 NULL）
  figureId     String? // 百度曦灵数字人 ID（克隆行由曦灵生成；公共行复制自 PublicAvatar.figureId）
  status       String   @default("GENERATING") // GENERATING / SUCCESS / FAILED（公共行恒为 SUCCESS）
  thumbnailUrl String? // 缩略图 URL（克隆：训练成功后填充；公共：复制 PublicAvatar.templateImg）
  kind         String   @default("CLONED") // CLONED / PUBLIC
  customerId   Int
  customer     Customer @relation(fields: [customerId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  scripts   Script[]

  @@unique([customerId, figureId]) // 同一客户下 figureId 不可重复；跨客户允许重复（同一公共形象可被多个客户绑定）
  @@index([customerId, kind])
}

// 音色表
// kind = CLONED：客户私有克隆音色；kind = PUBLIC：公共音色引用（perId 指向 PublicVoice）
model Voice {
  id              Int      @id @default(autoincrement())
  name            String // 音色名称
  gender          String   @default("female") // 性别: male / female / unknown
  description     String? // 音色描述
  trainingUrl     String? // 训练文件 URL（PUBLIC 行为 NULL）
  perId           String? // 百度曦灵声音 ID
  status          String   @default("GENERATING") // GENERATING / SUCCESS / FAILED（公共行恒为 SUCCESS）
  exampleText     String?  @db.VarChar(200) // 试听文本（提交克隆时记录；公共行 NULL）
  exampleAudioUrl String? // 示例音频 URL（克隆：成功后填充；公共：复制 PublicVoice.exampleAudioUrl）
  kind            String   @default("CLONED") // CLONED / PUBLIC
  customerId      Int
  customer        Customer @relation(fields: [customerId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  scripts   Script[]

  @@unique([customerId, perId]) // 同一客户下 perId 不可重复；跨客户允许重复
  @@index([customerId, kind])
}

// 公共形象镜像表（百度曦灵公共形象的本地镜像，TTL=24h 刷新）
// 弹窗 picker 从此表读；客户添加后在 Avatar 表插入 kind=PUBLIC 行并复制 figureId
model PublicAvatar {
  id               Int      @id @default(autoincrement())
  figureId         String   @unique // 百度主业务键
  name             String
  item             String // 百度组件类型：VIDEO-DH_2D / VIDEO-DH_2D_LITE / VIDEO-DH_3D
  gender           String? // MALE / FEMALE / UNKNOWN
  age              String? // 少年 / 青年 / 中年 / 老年
  pose             String? // 站姿全身 / 坐姿全身 / 坐姿半身
  background       String? // 透明 / 户外 / 室内
  tags             Json? // 百度 tags 数组（日常休闲 / 职业商务 等）
  templateImg      String?  @db.VarChar(1000) // 缩略图
  templateVideoUrl String?  @db.VarChar(1000) // 底板视频
  pictureUrl       String?  @db.VarChar(1000) // 参考图片（生成式数字人）
  maskVideoUrl     String?  @db.VarChar(1000) // mask 视频
  resolutionWidth  Int?
  resolutionHeight Int?
  aspectRatio      String? // 16:9 / 9:16 / 1:1（派生自分辨率，便于索引过滤）
  humanType        String? // 2D / 3D（从 item 派生）
  keepBackground   Boolean?
  isActive         Boolean  @default(true) // 下次刷新未返回则置 false（软失效，不物理删，绑定已在用的行靠此字段展示"已下架"）
  syncedAt         DateTime // 最近一次从百度拉取的时间

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, gender, age])
  @@index([isActive, humanType, aspectRatio])
}

// 公共音色镜像表
// 百度 /tts/persons?isSystem=true 只返回 6 个字段；age/style/language/capability/feature/latency
// 由 voice-tagger.ts 启发式从 name/describe/version 抽取（方案 C）
model PublicVoice {
  id              Int      @id @default(autoincrement())
  perId           String   @unique // 百度主业务键
  name            String
  describe        String?
  version         String? // 百度 version：V2 / LITE 等
  gender          String? // male / female / unknown
  exampleAudioUrl String?  @db.VarChar(1000)
  // 以下 6 字段为启发式标签，百度不返回
  age             String? // 少年 / 青少年 / 青年 / 中年
  style           String? // 权威专业 / 活力激情 / 亲和陪伴
  language        Json? // ["中文", "方言", "粤语", ...]
  capability      String? // 超拟 / 精品
  feature         String? // 温润柔和 / 清透明亮 / 低沉磁性
  latency         String? // 超低时延 / 低时延
  isActive        Boolean  @default(true)
  syncedAt        DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, gender])
}

enum ProjectStatus {
  DRAFT // 草稿
  PRODUCING // 生产中
  COMPLETED // 已完成
  PUBLISHED // 已发布
}

// 项目表
model Project {
  id     Int           @id @default(autoincrement())
  name   String // 项目名称
  status ProjectStatus @default(DRAFT) // 项目状态

  publishedAt DateTime? // 发布时间（精确到分钟，PUBLISHED 时填入）
  publishUrl  String?   @db.VarChar(1000) // 发布链接（PUBLISHED 时填入）

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])
  accountId  Int
  account    Account  @relation(fields: [accountId], references: [id])

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  source     Source?
  strategy   Strategy?
  production Production?
}

enum SourceType {
  HOT_TOPIC // 热点抓取
  CLIENT_BRIEF // 甲方文案
  DEEP_RESEARCH // 深度调研
}

// 来源层（一对一）
model Source {
  id           Int        @id @default(autoincrement())
  type         SourceType // 来源类型
  content      String     @db.Text // 内容（DEEP_RESEARCH 类型为调研结果，SUCCESS 后填充）
  query        String?    @db.Text // 调研问题（仅 DEEP_RESEARCH 使用）
  status       String     @default("SUCCESS") // GENERATING / SUCCESS / FAILED，非 DEEP_RESEARCH 恒为 SUCCESS
  errorMessage String?    @db.Text // 失败原因（仅 DEEP_RESEARCH 使用）
  projectId    Int        @unique
  project      Project    @relation(fields: [projectId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
}

// 方案层（一对一）
model Strategy {
  id                Int       @id @default(autoincrement())
  integrationType   String // 业务结合方式
  targetDurationSec Int // 目标时长（秒）
  content           String    @db.Text // 方案内容
  projectId         Int       @unique
  project           Project   @relation(fields: [projectId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
}

// 生产层（一对一）
model Production {
  id        Int       @id @default(autoincrement())
  topic     String // 项目主题
  projectId Int       @unique
  project   Project   @relation(fields: [projectId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  scripts        Script[]
  copyWritings   CopyWriting[]
  storyboards    Storyboard[]
  materialImages MaterialImage[]
}

// 口播稿
model Script {
  id      Int    @id @default(autoincrement())
  content String @db.Text // 口播稿

  avatarId Int?
