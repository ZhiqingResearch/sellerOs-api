// ==================== 公共扣费 v2 / 对外开放 ====================

// 功能模块注册表（扣费/统计的功能口径单一事实来源）：用量分析「功能」维度、积分明细「项目」列、
// v2/对外扣费的 source 校验全部从这里派生。seed 维护：`tsx prisma/seed.ts features`（勿手删行，历史数据引用 source）。
model FeatureModule {
  id          Int      @id @default(autoincrement())
  source      String   @unique @db.VarChar(50) // 功能 key，如 listing.generate（其他项目的功能也可注册，不限本平台菜单）
  label       String   @db.VarChar(50) // 中文名，如 "Listing 生成"
  module      String?  @db.VarChar(30) // 一级目录 key（selection/listing/...；null=未归类的历史功能）
  moduleLabel String?  @db.VarChar(50) // 一级目录中文名（冗余存储，免 join）
  active      Boolean  @default(true) // false=下线（拒绝新扣费，历史数据仍可见）
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([module, active])
}

// 对外开放接口的接入方（其他项目服务间调用扣费系统）：AppId + HMAC-SHA256 签名鉴权。
// 接入方用 scripts/create-open-api-app.ts 创建（secret 只在创建时打印一次）。
model OpenApiApp {
  isNiuniuOperationPlanEnabled Boolean  @default(false) // 是否允许调用牛牛运营计划（固定专用账号扣费）
  id                           Int      @id @default(autoincrement())
  appId                        String   @unique @db.VarChar(32)
  appSecret                    String   @db.VarChar(64) // 明文存储（HMAC 验签必须可还原；DB 内敏感，勿外泄）
  name                         String   @db.VarChar(50) // 接入方名（如「ERP 系统」）
  status                       String   @default("ACTIVE") @db.VarChar(20) // ACTIVE / DISABLED
  perCallMaxCny                Decimal? @db.Decimal(10, 2) // 单笔扣费上限（元），null=不限
  keybProjectCodes             Json     @default("[]") // 获准 KeyB 扣费的接入项目代码；空数组=未授权，逐请求读取
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

// 牛牛单链接运营计划：请求、扣费归属和交付快照；逻辑关联保留审计记录。
model OpenOperationPlanRequest {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt // 内部主键
  appId         String   @db.VarChar(32) // OpenApiApp.appId，接入方隔离
  requestId     String   @db.VarChar(64) // 每次生成的随机64位十六进制请求号；兼容历史链接SHA256请求号
  sourceUrl     String   @db.VarChar(1000) // 规范化后的商品详情链接
  billingUserId Int // 首次受理时的 User.id（沿用现有有符号 Int）
  runId         String   @unique @db.VarChar(100) // BusinessAiRun运行号
  input         Json // 自动解析的商品资料及默认编排参数
  aiRequest     Json // 本次生成的模型、提示词及运行号快照
  result        Json? // 业务校验及扣费成功后与流水同事务落存
  createdAt     DateTime @default(now()) // 首次受理时间
  updatedAt     DateTime @updatedAt // 交付更新时间

  @@unique([appId, requestId])
  @@index([billingUserId, createdAt])
}

// ==================== 会员 / 积分体系 ====================

// 接入项目凭证，与客户工作台 Project 无关；不存 KeyA 或 KeyB 明文。
enum SkillsKeyStatus {
  ROTATING
  ACTIVE
  SYNC_UNKNOWN
}

model SkillsKeyCredential {
  id                 Int             @id @default(autoincrement())
  userId             Int
  user               User            @relation(fields: [userId], references: [id])
  projectCode        String          @db.VarChar(50)
  externalProjectId  String          @db.VarChar(128)
  issuedPhone        String          @db.VarChar(11)
  keyCiphertext      String?         @db.Text
  keyHash            String?         @unique @db.VarChar(64)
  encryptionVersion  String?         @db.VarChar(16)
  maskedKey          String?         @db.VarChar(32)
  status             SkillsKeyStatus
  operationId        String          @db.VarChar(36)
  operationKind      String          @db.VarChar(10) // GENERATE / RESET
  // 仅保存已使用操作 UUID，不保存历史 Key；防止旧操作在新重置完成后再次签发。
  usedOperationIds   Json
  operationStartedAt DateTime
  activatedAt        DateTime?
  lastErrorCode      String?         @db.VarChar(50) // 仅服务端固定错误码
  revision           Int             @default(0) // 凭证行 CAS；不参与业务扣费去重
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([userId, projectCode])
  @@unique([externalProjectId, issuedPhone])
}

enum MembershipLevel {
  NONE
  LV1
  LV2
  LV3
  FOUNDER // LV4：被邀请人
  INVITER // LV5：邀请人
}

enum CreditBucket {
  RECHARGE // 充值积分(LV1/2/3) / 余额积分(LV4/5)：永不清零，可消费
  PACKAGE // 套餐 / 赠送积分：发放后 30 天过期，可消费
  GIFT // 注册赠送积分（送 200）：注册起 30 天过期，可消费
  REBATE // 返利积分（仅 LV5）：不可消费，仅提现
}

enum CreditLotStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
}

enum CreditDirection {
  CREDIT // 入账
  DEBIT // 出账
}

enum CreditTxnType {
  RECHARGE_PLAN // 会员套餐订阅
  RECHARGE_PACK // 固定充值包
  RECHARGE_CUSTOM // 自定义充值
  SIGNUP_BONUS // 注册赠送 200
  MANUAL_ADJUST // LV4/5 手动调额 / 历史迁移
  CONSUME // 消费扣减
  EXPIRE // 周期清零
  REBATE_IN // 返利入账
  REBATE_WITHDRAW // 返利提现
  TEAM_RECHARGE // 企业共享池非付款入账（平台定制开通/个人余额注入；团队付款走 RECHARGE_PLAN/PACK/CUSTOM）
  TEAM_CONSUME // 企业共享池消耗扣减
  TEAM_ARCHIVE_RETURN // 企业归档时充值包批次退回管理员个人户
}

// 调用方式：平台内使用（默认）/ 开放平台服务间扣费（/api/open/credit/* 与 KeyB 入口）
enum InvokeType {
  PLATFORM
  API
}

enum InviteAppStatus {
  PENDING
  APPROVED
  REJECTED
}

// 积分批次：消费与清零的最小单位（PACKAGE 按每笔各自 30 天过期，故用批次台账而非单一余额）
model CreditLot {
  id         Int             @id @default(autoincrement())
  userId     Int
  user       User            @relation(fields: [userId], references: [id])
  bucket     CreditBucket
  amount     Decimal         @db.Decimal(18, 4) // 发放额
  remaining  Decimal         @db.Decimal(18, 4) // 剩余（消费/清零递减）
  expiresAt  DateTime? // null=永不过期(RECHARGE/REBATE)；PACKAGE/GIFT(注册送)=grantedAt+30d
  grantedAt  DateTime        @default(now())
  sourceType CreditTxnType
  sourceRef  String?         @db.VarChar(100) // 订单号 / 操作引用
  status     CreditLotStatus @default(ACTIVE)
  teamId     Int? // 归属企业共享池（弱引用 Team.id）；null=个人批次
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([userId, bucket, status, expiresAt])
  @@index([teamId, bucket, status])
}

// 积分流水 / 明细 / 清零记录 / 审计：所有积分变动各记一条（lotId / relatedUserId 为弱引用，不建外键）
model CreditTransaction {
  id            Int             @id @default(autoincrement())
  userId        Int
  user          User            @relation(fields: [userId], references: [id])
  direction     CreditDirection
  bucket        CreditBucket? // 一次消费跨桶 → 拆多条
  type          CreditTxnType
  amount        Decimal         @db.Decimal(18, 4)
  balanceAfter  Decimal?        @db.Decimal(18, 4) // 该桶扣后余额
  source        String?         @db.VarChar(100) // 业务来源：listing.generate 等
  invokeType    InvokeType      @default(PLATFORM) // 调用方式：PLATFORM=平台使用 / API=开放平台扣费（meta.appId 存量回填）
  lotId         Int? // 关联批次
  relatedUserId Int? // 返利 / 共享扣费：与本人相关的另一方（被邀请人）id
  teamId        Int? // 企业池扣费留痕（弱引用 Team.id）
  meta          Json?
  createdAt     DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([userId, type])
  @@index([relatedUserId]) // 反查：邀请人「使用用户」明细 / 被邀请人「动用邀请人额度」明细
  @@index([teamId, createdAt])
}

// LV1/2/3 会员套餐配置
model MembershipPlan {
  id               Int      @id @default(autoincrement())
  tier             Int      @unique // 1/2/3
  name             String   @db.VarChar(50) // Explorer/Plus/Ultra
  priceCny         Decimal  @db.Decimal(10, 2) // 人民币定价（元）
  originalPriceCny Decimal? @db.Decimal(10, 2) // 划线价（元）
  packageCredits   Int // 套餐积分 → PACKAGE(30d)
  giftCredits      Int // 赠送积分 → PACKAGE(30d)
  periodDays       Int      @default(30)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// 续费「排队生效」队列：未到期续费先入队，当前订阅到期后按 activateAt 顺序激活
// 激活时才发积分 / 切等级（下单时只占位、下单即锁定，不可取消）。存套餐快照防配置变动影响已下单。
model ScheduledPlan {
  id             Int                 @id @default(autoincrement())
  userId         Int
  user           User                @relation(fields: [userId], references: [id])
  tier           Int // 续费目标档 1/2/3（可降/平/升）
  activateAt     DateTime // 计划激活时刻 = 当前订阅 + 已排队套餐的队尾到期时刻
  status         ScheduledPlanStatus @default(PENDING)
  // 套餐快照（下单即锁定，激活时按此发放，不受 MembershipPlan 后续改动影响）
  planName       String              @db.VarChar(50)
  priceCny       Decimal             @db.Decimal(10, 2)
  packageCredits Int
  giftCredits    Int
  periodDays     Int
  createdAt      DateTime            @default(now())
  activatedAt    DateTime?
  teamId         Int? // 团队续费排队（弱引用 Team.id）；null=个人续费

  @@index([status, activateAt])
  @@index([userId, status])
  @@index([teamId, status])
}

enum ScheduledPlanStatus {
  PENDING // 待生效（排队中）
  ACTIVATED // 已激活
  CANCELLED // 已取消（加入团队/个人转团队时作废排队单）
}

// 固定充值包配置
model RechargePack {
  id           Int      @id @default(autoincrement())
  priceCny     Decimal  @db.Decimal(10, 2) // 30/100/500（元）
  baseCredits  Int // → RECHARGE（永不过期）
  bonusCredits Int // → PACKAGE(30d)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 邀请注册申请：提交即 PENDING，邀请人审核通过才建/启用账号
model InviteApplication {
  id           Int             @id @default(autoincrement())
  inviterId    Int
  inviter      User            @relation(fields: [inviterId], references: [id])
  username     String?         @db.VarChar(50) // 注册时填写的称谓（真人名），审核通过后作为用户名；旧数据可空
  email        String          @db.VarChar(120)
  phone        String          @db.VarChar(20)
  passwordHash String // argon2，审核通过才落用户表
  inviteCode   String          @db.VarChar(32)
  status       InviteAppStatus @default(PENDING)
  // 「待审手机号」条件唯一：PENDING 时 = phone、审批/拒绝时置 null（MySQL 唯一索引允许多 NULL）。
  // 借此在 DB 层强制「同一手机号至多一份待审申请」，又不影响拒绝后用同号再次申请。
  pendingPhone String?         @unique @db.VarChar(20)
  createdAt    DateTime        @default(now())
  reviewedAt   DateTime?

  @@index([inviterId, status])
  @@index([status])
}

// 邮箱验证码（镜像 SmsCode，用于邀请注册）
model EmailCode {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(120)
  code      String
  used      Boolean  @default(false)
  attempts  Int      @default(0) // 连续校验失败次数，≥5 作废当前码（防爆破）
  expiredAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// 邮箱登录账号（邮箱注册/登录/找回密码通道专用；与 User.email 通知字段无关，互不影响）
model EmailAccount {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(120) // 一律小写归一存储，库级唯一防并发注册撞车
  userId    Int      @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

// 邮箱认证验证码（与邀请注册的 EmailCode 完全隔离；purpose 区分场景，注册码/重置码互不通用）
model EmailAuthCode {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(120)
  purpose   String // REGISTER | RESET
  code      String
  used      Boolean  @default(false)
  attempts  Int      @default(0) // 连续校验失败次数，≥5 作废当前码（防爆破）
  expiredAt DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

// 跨域登录交接码（海外首页 → Seller 主站）：sha256 哈希落库不存明文，60s 有效、单次原子核销
model AuthHandoffCode {
  id        Int       @id @default(autoincrement())
  codeHash  String    @unique @db.VarChar(64) // sha256(code) 十六进制
  userId    Int
  usedAt    DateTime? // 非空 = 已核销（条件 updateMany 原子单次）
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ==================== RBAC 权限系统 ====================

model RoleModel {
  id          Int              @id @default(autoincrement())
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(500)
  color       String?          @db.VarChar(20)
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]

  @@map("Role")
}

model UserRole {
  userId    Int
  roleId    Int
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      RoleModel @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Organization {
  id        Int                @id @default(autoincrement())
  name      String             @unique @db.VarChar(100)
  note      String?            @db.VarChar(500)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  users     UserOrganization[]
}

model UserOrganization {
  userId    Int
  orgId     Int
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([userId, orgId])
  @@index([orgId])
}

/// 菜单/权限分组：Permission.groupCode 的管理实体（code 创建后不可改；内置组不可删）
model PermissionGroup {
  id        Int      @id @default(autoincrement())
  /// 分组编码，全局唯一，如 tools / management
  code      String   @unique @db.VarChar(50)
  /// 分组名（前端展示用），如「工具」
  label     String   @db.VarChar(100)
  /// 内置分组（seed 初始化），不可删除
  isBuiltin Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

model Permission {
  id        Int              @id @default(autoincrement())
  key       String           @unique @db.VarChar(100)
  label     String           @db.VarChar(200)
  groupCode String           @db.VarChar(50)
  parentKey String?          @db.VarChar(100)
  route     String?          @db.VarChar(200)
  subRoutes Json?
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  roles     RolePermission[]

  @@index([groupCode, sortOrder])
}

model RolePermission {
  roleId       Int
  permissionId Int
  createdAt    DateTime   @default(now())
  role         RoleModel  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

enum CrawlOutcome {
  SUCCESS
  FAILED
}

model Product {
  id        Int        @id @default(autoincrement())
  url       String     @db.Text
  urlHash   String     @unique @db.VarChar(64)
  platform  String     @db.VarChar(50)
  name      String     @db.VarChar(500)
  data      Json
  fetchedAt DateTime
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  crawlLogs CrawlLog[]

  @@index([platform])
}

model CrawlLog {
  id           Int          @id @default(autoincrement())
  userId       Int
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  url          String       @db.Text
  outcome      CrawlOutcome
  productId    Int?
  product      Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  errorCode    String?      @db.VarChar(100)
  errorMessage String?      @db.Text
  durationMs   Int?
  createdAt    DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([productId])
}

// ASIN 审计商品详情：与 Product 完全隔离的独立缓存表（字段比 Product 多 qa/review/product_information_hhl
// 等，结构也可能不同；独立存表避免污染 products/detail 的前端渲染）。urlHash=sha256(最终URL) 唯一缓存键，
// 传 ASIN 时按 country 域名拼出 URL 再算 hash。data 原样存爬虫返回的审计富数据。不参与软删除。
model AuditProduct {
  id        Int      @id @default(autoincrement())
  url       String   @db.Text
  urlHash   String   @unique @db.VarChar(64)
  platform  String   @db.VarChar(50)
  country   String   @db.VarChar(10)
  asin      String?  @db.VarChar(32)
  name      String   @db.VarChar(500)
  data      Json
  fetchedAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platform])
  @@index([asin])
}

/// 用户 ASIN 审计记录状态
enum AsinAuditRecordStatus {
  /// 已保存取证与评分结果，尚未生成优化方案
  SCORED
  /// 已至少生成一次优化方案
  OPTIMIZED
}

/// 用户的一轮 ASIN 审计；只保存列表和检索需要的摘要字段
model AsinAuditRecord {
  /// 对外暴露的审计记录 UUID
  id     String @id @default(uuid()) @db.VarChar(36)
  /// 所属用户，从 JWT 获取
  userId Int
  user   User   @relation(fields: [userId], references: [id])

  /// 前端创建请求 UUID，用于避免网络重试产生重复记录
  clientRequestId   String @db.VarChar(36)
  /// 规范化创建内容的 SHA-256，用于识别幂等键误复用
  createFingerprint String @db.Char(64)

  /// 商品和类目摘要
  asin           String @db.Char(10)
  marketplace    String @db.VarChar(16)
  country        String @db.VarChar(16)
  productTitle   String @db.VarChar(1000)
  categoryNodeId String @db.VarChar(255)
  categoryName   String @db.VarChar(500)
  categoryPath   String @db.VarChar(1000)

  /// 列表展示需要的评分摘要；完整结果在 AsinAuditScoreSnapshot
  adIncluded   Boolean
  overallScore Float
  grade        String  @db.VarChar(16)
  contentScore Float
  trafficScore Float
  adScore      Float?

  /// 主记录状态和乐观锁版本
  status                     AsinAuditRecordStatus @default(SCORED)
  version                    Int                   @default(1)
  /// 0 表示尚未优化，否则指向当前最新的优化 revision
  latestOptimizationRevision Int                   @default(0)
  optimizedAt                DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  /// 第一步固定快照及历次优化结果
  scoreSnapshot         AsinAuditScoreSnapshot?
  optimizationRevisions AsinAuditOptimizationRevision[]

  @@unique([userId, clientRequestId])
  @@index([userId, deletedAt, createdAt])
  @@index([userId, marketplace, deletedAt, createdAt], map: "AsinAuditRecord_user_marketplace_created_idx")
  @@index([userId, asin, deletedAt, createdAt], map: "AsinAuditRecord_user_asin_created_idx")
}

/// 一轮审计的取证与评分固定快照；recordId 同时作为主键以保证严格一对一
model AsinAuditScoreSnapshot {
  recordId String          @id @db.VarChar(36)
  record   AsinAuditRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  schemaVersion Int
  /// A/P/B/C/D/E 六卡证据及 meta
  evidence      Json
  /// 完整十维评分、criteria、问题及建议
  scoreResult   Json
  /// 规范化快照内容的 SHA-256
  payloadHash   String @db.Char(64)
  /// evidence + scoreResult 的 UTF-8 JSON 字节数
  payloadBytes  Int

  createdAt DateTime @default(now())
}

/// 一轮审计的单次 AI 优化结果；每次不同的优化产生一个新 revision
model AsinAuditOptimizationRevision {
  id Int @id @default(autoincrement())

  recordId           String
  record             AsinAuditRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  /// 当前审计记录内从 1 开始递增的优化版本
  revision           Int
  schemaVersion      Int
  optimizationResult Json
  /// 规范化优化内容的 SHA-256，用于重复提交幂等
  payloadHash        String          @db.Char(64)
  /// optimizationResult 的 UTF-8 JSON 字节数
  payloadBytes       Int

  createdAt DateTime @default(now())

  @@unique([recordId, revision])
  @@index([recordId, createdAt])
}

/// ASIN 取证记录（取证模块）：一次取证一条，取证结果 JSON 原样保存；软删除
model AsinEvidenceRecord {
  /// 对外暴露的取证记录 UUID
  id     String @id @default(uuid()) @db.VarChar(36)
  /// 所属用户，从 JWT 获取
  userId Int
  user   User   @relation(fields: [userId], references: [id])

  /// 前端创建请求 UUID，用于避免网络重试产生重复记录
  clientRequestId   String @db.VarChar(36)
  /// 规范化创建内容的 SHA-256，用于识别幂等键误复用
  createFingerprint String @db.Char(64)

  /// Amazon ASIN（trim + 大写）
  asin         String  @db.Char(10)
  /// 站点（US | UK | DE，与取证接口 country 同枚举）
  country      String  @db.VarChar(16)
  /// 商品名摘要：优先取前端传入，缺省时从取证结果提取，取不到置 null
  productTitle String? @db.VarChar(1000)
  /// 取证完整结果（六卡 A/P/B/C/D/E + meta + richPainPoints/highlights + reviewSamples）
  evidence     Json
  /// B 卡评论分析模型
  model        String  @db.VarChar(64)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([userId, clientRequestId])
  @@index([userId, deletedAt, createdAt])
  @@index([userId, country, deletedAt, createdAt])
  @@index([userId, asin, deletedAt, createdAt])
}

// ============================================================
// 图片创作模块（独立于 customer 模块）
// 业务结构：ImageProject → { ProductProfile, BrandIdentity, ProductImage[], TaskCenter[] → GeneratedImage[] }
// 设计要点：
//   - preset / model / designStyle 等枚举值前端写死，后端用 String 存（保留扩展性）
//   - TaskCenter.refImageUrls 存 URL 快照，避免 ProductImage 软删后任务历史断链
//   - GeneratedImage 沿用 MaterialImageVariant 的「席位」模式：父级聚合 status，子级独立 status
// ============================================================

model ImageProject {
  id     Int    @id @default(autoincrement())
  // 项目来源：platform 本平台 / vidflowos VidFlowOS 代办容器项目（列表默认过滤）
  source String @default("platform") @db.VarChar(20)
  name   String @db.VarChar(200)
  type   String @default("ECOMMERCE") @db.VarChar(20) // GENERAL 通用 / ECOMMERCE 电商 / PORTRAIT 人像
  status String @default("DRAFT") // DRAFT / GENERATING / COMPLETED / ARCHIVED
  userId Int
  user   User   @relation(fields: [userId], references: [id])

  productProfile     ProductProfile?
  brandIdentity      BrandIdentity?
  productImages      ProductImage[]
  tasks              GenerationTask[]
  productPublishTask ProductPublishTask?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, deletedAt])
  @@index([userId, type])
  @@index([status])
}

enum ProductPublishTaskStatus {
  DRAFT
  COMPLETED
  PUBLISHING
}

enum ProductPublishType {
  SINGLE
  VARIANT
}

enum ProductPublishTemplateStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ProductPublishOutcome {
  SUCCESS
  PARTIAL_SUCCESS
  FAILED
  TIMEOUT
}

enum ProductPublishRpaOperation {
  FETCH_TEMPLATE
  SUBMIT_PUBLISH
  QUERY_RESULT
}

enum ProductPublishRpaLogSource {
  API
  CRON
}

enum ProductPublishRpaLogStatus {
  DISPATCHING
  WAITING_CALLBACK
  PROCESSING_CALLBACK
  SUCCESS
  FAILED
  TIMEOUT
}

enum ProductPublishRpaRunStatus {
  RUNNING
  SUCCESS
  PARTIAL_FAILED
  FAILED
  SKIPPED
}

enum ProductPublishFeishuSyncTrigger {
  SCHEDULED
  MANUAL
}

enum ProductPublishFeishuSyncStatus {
  RUNNING
  SUCCESS
  PARTIAL_FAILED
  FAILED
  SKIPPED
}

enum ProductPublishFeishuSyncRecordStatus {
  SUCCESS
  SKIPPED
  FAILED
}

enum ProductPublishFeishuSyncAction {
  CREATED
  UPDATED
  SKIPPED
}

// 一次飞书店铺同步的批次汇总，手动触发与定时触发使用同一套审计模型。
model ProductPublishFeishuSyncRun {
  id           Int                              @id @default(autoincrement())
  trigger      ProductPublishFeishuSyncTrigger
  status       ProductPublishFeishuSyncStatus   @default(RUNNING)
  startedAt    DateTime                         @default(now())
  finishedAt   DateTime?
  durationMs   Int?
  totalCount   Int                              @default(0)
  successCount Int                              @default(0)
  failedCount  Int                              @default(0)
  skippedCount Int                              @default(0)
  errorMessage String?                          @db.Text
  records      ProductPublishFeishuSyncRecord[]
  createdAt    DateTime                         @default(now())
  updatedAt    DateTime                         @updatedAt

  @@index([status, startedAt])
  @@index([trigger, startedAt])
}

// 飞书同步批次内每一行的处理结果；失败记录也保留原始定位信息。
model ProductPublishFeishuSyncRecord {
  id              Int                                  @id @default(autoincrement())
  runId           Int
  run             ProductPublishFeishuSyncRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  feishuRecordId  String?                              @db.VarChar(100)
  externalStoreId String?                              @db.VarChar(32)
  status          ProductPublishFeishuSyncRecordStatus
  action          ProductPublishFeishuSyncAction?
  message         String?                              @db.Text
  durationMs      Int?
  sourceUpdatedAt DateTime?
  createdAt       DateTime                             @default(now())

  @@index([runId, status])
  @@index([feishuRecordId, createdAt])
  @@index([externalStoreId, createdAt])
}

// 飞书同步的上架店铺。externalStoreId 是业务店铺 ID，不参与数值计算。
model ProductPublishStore {
  id              Int       @id @default(autoincrement())
  externalStoreId String    @unique @db.VarChar(32)
  feishuRecordId  String    @db.VarChar(100)
  sourceUuid      String?   @db.VarChar(100)
  name            String    @db.VarChar(200)
  shortName       String?   @db.VarChar(100)
  companyName     String?   @db.VarChar(200)
  platform        String    @default("AMAZON") @db.VarChar(50)
  storeType       String?   @db.VarChar(50)
  accountType     String?   @db.VarChar(50)
  childStore      String?   @db.VarChar(200)
  site            String?   @db.VarChar(50)
  remark          String?   @db.Text
  disabled        Boolean   @default(false)
  sourceUpdatedAt DateTime?
  lastSyncedAt    DateTime  @default(now())

  classifications ProductPublishStoreClassification[]
  publishTasks    ProductPublishTask[]
  rpaLogs         ProductPublishRpaLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([disabled, platform])
  @@index([feishuRecordId])
}

// 全局分类目录。店铺同步时从目录复制分类映射；导入脚本会同步既有映射的名称和排序。
model ProductPublishClassificationCatalog {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(100)
  name      String   @db.VarChar(100)
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

// 每个店铺的分类模板；模板链接由 RPA 定期刷新并持久化。
model ProductPublishStoreClassification {
  id                 Int                          @id @default(autoincrement())
  storeId            Int
  store              ProductPublishStore          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  classification     String                       @db.VarChar(100)
  classificationName String                       @db.VarChar(100)
  sortOrder          Int                          @default(0)
  templateUrl        String?                      @db.VarChar(1000)
  templateStatus     ProductPublishTemplateStatus @default(PENDING)
  templateSyncedAt   DateTime?
  lastSyncError      String?                      @db.Text
  rpaTaskUuid        String?                      @db.VarChar(100)
  templateRequestId  String?                      @unique @db.VarChar(100)
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  @@unique([storeId, classification])
  @@index([storeId, sortOrder])
  @@index([templateStatus, templateSyncedAt], map: "PPSC_templateStatus_syncedAt_idx")
}

// 一键上架任务。草稿可暂不关联图片项目，完成时由业务层保证已关联。
model ProductPublishTask {
  id                   Int                      @id @default(autoincrement())
  taskId               String                   @unique @db.VarChar(36)
  userId               Int
  user                 User                     @relation(fields: [userId], references: [id])
  imageProjectId       Int?                     @unique
  imageProject         ImageProject?            @relation(fields: [imageProjectId], references: [id], onDelete: SetNull)
  publishStoreId       Int?
  publishStore         ProductPublishStore?     @relation(fields: [publishStoreId], references: [id], onDelete: SetNull)
  productName          String?                  @db.VarChar(200)
  brand                String?                  @db.VarChar(200)
  classification       String?                  @db.VarChar(100)
  category             String?                  @db.VarChar(500)
  data                 Json?
  status               ProductPublishTaskStatus @default(DRAFT)
  store                String?                  @db.VarChar(200)
  type                 ProductPublishType?
  productImages        Json?
  progress             Int                      @default(0)
  spreadsheetUrl       String?                  @db.VarChar(1000)
  spreadsheetKey       String?                  @db.VarChar(1000)
  uploadId             String?                  @unique @db.VarChar(100) // Amazon 服务生成的文件批次 ID，不是 RPA 标识
  rpaTaskUuid          String?                  @db.VarChar(100)
  rpaJobUuidList       Json?
  submitRequestId      String?                  @unique @db.VarChar(100)
  submitCorrelationKey String?                  @unique @db.VarChar(64)
  resultRequestId      String?                  @unique @db.VarChar(100)
  successCount         Int                      @default(0)
  failedCount          Int                      @default(0)
  submittedFileUrl     String?                  @db.VarChar(1000)
  resultFileUrl        String?                  @db.VarChar(1000)
  skus                 Json? // 首次提交上架时冻结的原始 SKU 字符串列表
  skuAsinMapping       Json?
  publishOutcome       ProductPublishOutcome?
  publishSubmittedAt   DateTime?
  publishCompletedAt   DateTime?
  lastPolledAt         DateTime?
  nextPollAt           DateTime?
  pollAttempts         Int                      @default(0)
  publishErrorMessage  String?                  @db.Text
  rpaLogs              ProductPublishRpaLog[]
  completedAt          DateTime?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  deletedAt            DateTime?

  @@index([userId, status, updatedAt])
  @@index([userId, store])
  @@index([userId, classification])
  @@index([userId, type])
  @@index([userId, deletedAt])
  @@index([status, nextPollAt])
  @@index([publishStoreId, status, createdAt])
}

// 模板刷新与结果轮询 Cron 的执行批次；即使没有待处理数据，也保留一次运行记录。
model ProductPublishRpaRun {
  id           Int                        @id @default(autoincrement())
  operation    ProductPublishRpaOperation
  status       ProductPublishRpaRunStatus @default(RUNNING)
  startedAt    DateTime                   @default(now())
  finishedAt   DateTime?
  durationMs   Int?
  totalCount   Int                        @default(0)
  successCount Int                        @default(0)
  failedCount  Int                        @default(0)
  skippedCount Int                        @default(0)
  errorMessage String?                    @db.Text
  logs         ProductPublishRpaLog[]
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt

  @@index([operation, startedAt])
  @@index([status, startedAt])
}

// 影刀请求审计日志。密钥、Token 和 Authorization 请求头不得写入 payload。
model ProductPublishRpaLog {
  id                      Int                        @id @default(autoincrement())
  operation               ProductPublishRpaOperation
  source                  ProductPublishRpaLogSource
  runId                   Int?
  run                     ProductPublishRpaRun?      @relation(fields: [runId], references: [id], onDelete: SetNull)
  taskId                  Int?
  task                    ProductPublishTask?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  storeId                 Int?
  store                   ProductPublishStore?       @relation(fields: [storeId], references: [id], onDelete: SetNull)
  classification          String?                    @db.VarChar(100)
  requestId               String?                    @unique @db.VarChar(100)
  idempotentUuid          String?                    @db.VarChar(100)
  rpaTaskUuid             String?                    @db.VarChar(100)
  rpaJobUuidList          Json?
  uploadId                String?                    @db.VarChar(100) // Amazon 业务文件批次 ID
  requestPayload          Json?
  status                  ProductPublishRpaLogStatus @default(DISPATCHING)
  dispatchResponsePayload Json?
  responsePayload         Json? // RPA 业务回调 payload，保留结构并移除 URL 签名参数
  dispatchedAt            DateTime?
  callbackReceivedAt      DateTime?
  expiresAt               DateTime?
  httpStatus              Int?
  success                 Boolean                    @default(false)
  durationMs              Int                        @default(0)
  dispatchDurationMs      Int?
  attempt                 Int                        @default(1)
  errorMessage            String?                    @db.Text
  createdAt               DateTime                   @default(now())

  @@index([taskId, createdAt])
  @@index([runId, createdAt])
  @@index([storeId, operation, createdAt])
  @@index([operation, success, createdAt])
  @@index([status, expiresAt])
  @@index([uploadId])
}

model ProductProfile {
  id        Int          @id @default(autoincrement())
  projectId Int          @unique
  project   ImageProject @relation(fields: [projectId], references: [id])

  // 商品资料语言：旧字段始终保存 defaultLocale 对应版本，兼容现有前端和生成链路
  sourceLocale  String? @db.VarChar(20)
  defaultLocale String  @default("zh-CN") @db.VarChar(20)

  // 基础信息
  productName String? @db.VarChar(200)
  sku         String? @db.VarChar(100)
  brandName   String? @db.VarChar(200)

  // 类目 3 级
  categoryL1 String? @db.VarChar(100)
  categoryL2 String? @db.VarChar(100)
  categoryL3 String? @db.VarChar(100)

  // 目标国家/地区 & 电商平台（前端多选）
  targetCountries    Json? // string[]
  ecommercePlatforms Json? // string[]

  // 商业数据（URL 抓取后自动填充：售价 / 评分 / BSR / 变体数 / 履约方式）
