DEFAULT_MEMBER_ROLE_ID=""
STRIPE_SECRET_KEY=""            # sk_test_... / sk_live_...；未配置则在线支付不可用（不影响其它功能启动）
STRIPE_PUBLISHABLE_KEY=""       # pk_test_... / pk_live_...（银行卡 Elements 前端用，随 pay 接口下发）
STRIPE_WEBHOOK_SECRET=""        # webhook 验签密钥；本地联调用 stripe listen 转发拿的 whsec_...
PUPPETEER_EXECUTABLE_PATH=""    # 收据 PDF 用系统 Chromium 路径（如 /usr/bin/chromium-browser）；未配置则收据邮件无 PDF 附件
BILLING_ALERT_EMAIL=""          # 计费告警收件人（金额不符/拒付/入账失败），多个逗号分隔

# ===== 通用生图管线（轨道 A+B，2026-09） =====
# 网关切换：默认 gateway（产品决议）；显式 direct 才回退 9 个直连适配器
# （同时恢复 provider 白名单的严格校验）。回滚 = 设 direct。
# IMAGE_PIPELINE_GATEWAY_TARGET=gateway
# 走 gateway 必填（uat 部署环境已配置则复用同一把）：
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=https://ai-gateway-api-dev.zhilingtech.com/v1
# 网关任务轮询截止毫秒（默认 8 分钟，须小于 t2i 10 分钟对账 deadline）：
# IMAGE_GATEWAY_POLL_TIMEOUT_MS=480000
# 执行器并发与对账 deadline（默认 6 / 10 分钟 / 15 分钟）：
# IMAGE_GEN_MAX_CONCURRENCY=6
# IMAGE_GEN_T2I_DEADLINE_MS=600000
# IMAGE_GEN_I2I_DEADLINE_MS=900000
# direct 回退通道的 provider 直连密钥（gateway 全量稳定后随 B4 一并清理）：
# APIFOX_API_URL / APIFOX_API_KEY / CHADGPT_API_KEY / OPENAI_API_KEY /
# TOKENLAB_API_URL / TOKENLAB_IMAGE_MODEL；ATLASCLOUD_API_KEY 与 SPACES_* 为既有变量

# 通联国内扫码支付：默认关闭，启用时必填以下配置；仅使用 RSA（SHA1WithRSA）
# 发布顺序：npm ci -> npx prisma generate -> npm run db:push -> 后端 -> 前端。
# 按项目约定只用 db:push（不跑 migrate）；未同步新增订单字段前不可启动新后端。
# 首次上线需逐一验证 W01 微信、A01 支付宝、U01 云闪付实付与重复通知幂等。
# 如需停止新订单，将 ENABLED 置 false；保留其余配置供存量查单和回调验签。
# 本版严格核对原金额与交易金额，不同金额（包括渠道优惠）转人工核实，不自动发积分。
ALLINPAY_ENABLED=false
# 当前对接收银宝生产接口；本地运行也会产生真实支付。
# 通联测试环境需另行确认统一下单权限、商户参数及验签公钥，不能仅替换域名。
# 不付款的模拟回调使用隔离自动化测试，不修改这里的真实商户配置。
ALLINPAY_API_ORIGIN=https://vsp.allinpay.com
ALLINPAY_CUSID=
ALLINPAY_APPID=
# 商户 RSA 私钥 PEM（支持字面量 \n 换行），公钥需匹配通联后台的 RSA 公钥配置
ALLINPAY_PRIVATE_KEY=
# 通联验签公钥 PEM（不是商户自己的公钥）
ALLINPAY_PUBLIC_KEY=
ALLINPAY_NOTIFY_URL=https://your-api.example.com/api/billing/webhooks/allinpay
ALLINPAY_PAYEE=

# ── 车泰斗 AI 商品素材工作台 ──
# 默认开启，无需配置；需要关闭时设置 CHETAIDOU_ENABLED=false
# 模型在 AiGatewayModel 目录按分类配置，文本和图片均支持多项：
# CHETAIDOU_MULTIMODAL（拆解/文本）、CHETAIDOU_IMAGE（生图）
# 新环境统一初始化：npm run chetaidou:init -- --enable --text-multiplier=1 --image-multiplier=1
# 先加 --dry-run 预检；生图比例、分辨率和质量由用户设置与模型能力解析，不使用模型/质量 env。
