// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`buildImagePrompt — preset templates produces a stable Chinese prompt for each of the 10 built-in image types 1`] = `
{
  "detail_closeup": "语言=简体中文。硬性要求：图中出现的所有文字、标题、标注、尺寸标注、单位、卖点文字、贴纸、品牌词等全部必须使用简体中文，严禁出现英文、日文、韩文或其他外语字符。文字密度=常规：图中中文字符总量必须为 16-28 个中文字符（含所有标签、卖点、标注，每一个汉字计 1）；保持适中的标签与简短卖点说明，不空白也不堆砌。三件装透气速干短袖 T 恤 关键细节微距特写，纹理 / 按钮 / 接口 / 缝线等工艺细节，服装鞋帽 男士速干 T 恤，采用透气速干面料，吸湿排汗效果佳。三件装包含黑白灰经典配色，适合运动健身或日常穿着，浅景深，专业微距摄影光线，1:1 比例，1024x1024 分辨率。基于图 1 主体合理放大推断细节。最后提醒：图中渲染的每一个字符都必须是简体中文，即使产品描述中包含英文也要翻译成中文后再渲染到图中，不得直接保留英文字符。定稿前再次检查：图中中文字符总数必须落在 16-28 个中文字符 区间内，不少于 16、不多于 28。",
  "main_white_front": "语言=简体中文。硬性要求：图中出现的所有文字、标题、标注、尺寸标注、单位、卖点文字、贴纸、品牌词等全部必须使用简体中文，严禁出现英文、日文、韩文或其他外语字符。文字密度=常规：图中中文字符总量必须为 16-28 个中文字符（含所有标签、卖点、标注，每一个汉字计 1）；保持适中的标签与简短卖点说明，不空白也不堆砌。纯白色背景 (#FFFFFF)，三件装透气速干短袖 T 恤，服装鞋帽 男士速干 T 恤，采用透气速干面料，吸湿排汗效果佳。三件装包含黑白灰经典配色，适合运动健身或日常穿着，产品正面居中，占画面 85%，无文字无水印无阴影，专业商业摄影，柔和均匀布光，高清细节，1:1 比例，1024x1024 分辨率。主要参考图 1 还原正面。最后提醒：图中渲染的每一个字符都必须是简体中文，即使产品描述中包含英文也要翻译成中文后再渲染到图中，不得直接保留英文字符。定稿前再次检查：图中中文字符总数必须落在 16-28 个中文字符 区间内，不少于 16、不多于 28。",
  "packaging": "语言=简体中文。硬性要求：图中出现的所有文字、标题、标注、尺寸标注、单位、卖点文字、贴纸、品牌词等全部必须使用简体中文，严禁出现英文、日文、韩文或其他外语字符。文字密度=常规：图中中文字符总量必须为 16-28 个中文字符（含所有标签、卖点、标注，每一个汉字计 1）；保持适中的标签与简短卖点说明，不空白也不堆砌。三件装透气速干短袖 T 恤 及所有配件俯拍平铺 (Flat Lay)，主产品居中，服装鞋帽 男士速干 T 恤，采用透气速干面料，吸湿排汗效果佳。三件装包含黑白灰经典配色，适合运动健身或日常穿着，白底，整齐排列展示开箱全部内容，每个配件之间留有间距，1:1 比例，1024x1024 分辨率。主产品以图 1 为准。最后提醒：图中渲染的每一个字符都必须是简体中文，即使产品描述中包含英文也要翻译成中文后再渲染到图中，不得直接保留英文字符。定稿前再次检查：图中中文字符总数必须落在 16-28 个中文字符 区间内，不少于 16、不多于 28。",
  "scene": "语言=简体中文。硬性要求：图中出现的所有文字、标题、标注、尺寸标注、单位、卖点文字、贴纸、品牌词等全部必须使用简体中文，严禁出现英文、日文、韩文或其他外语字符。文字密度=常规：图中中文字符总量必须为 16-28 个中文字符（含所有标签、卖点、标注，每一个汉字计 1）；保持适中的标签与简短卖点说明，不空白也不堆砌。三件装透气速干短袖 T 恤 在真实使用场景中，根据「服装鞋帽 男士速干 T 恤」挑选合适的真实使用场景，服装鞋帽 男士速干 T 恤，采用透气速干面料，吸湿排汗效果佳。三件装包含黑白灰经典配色，适合运动健身或日常穿着，产品清晰可辨，自然光线，生活化氛围，核心卖点基于产品描述自动挑选 3 个亮点呈现，1:1 比例，1024x1024 分辨率。产品主体严格参考图 1，场景自由发挥。最后提醒：图中渲染的每一个字符都必须是简体中文，即使产品描述中包含英文也要翻译成中文后再渲染到图中，不得直接保留英文字符。定稿前再次检查：图中中文字符总数必须落在 16-28 个中文字符 区间内，不少于 16、不多于 28。",
  "selling_point": "语言=简体中文。硬性要求：图中出现的所有文字、标题、标注、尺寸标注、单位、卖点文字、贴纸、品牌词等全部必须使用简体中文，严禁出现英文、日文、韩文或其他外语字符。文字密度=常规：图中中文字符总量必须为 16-28 个中文字符（含所有标签、卖点、标注，每一个汉字计 1）；保持适中的标签与简短卖点说明，不空白也不堆砌。三件装透气速干短袖 T 恤 产品图，服装鞋帽 男士速干 T 恤，采用透气速干面料，吸湿排汗效果佳。三件装包含黑白灰经典配色，适合运动健身或日常穿着，从产品描述中挑选 3 个最关键卖点并标注，箭头指向对应位置，简洁信息图设计，品牌感，1:1 比例，1024x1024 分辨率。产品主体严格参考图 1。最后提醒：图中渲染的每一个字符都必须是简体中文，即使产品描述中包含英文也要翻译成中文后再渲染到图中，不得直接保留英文字符。定稿前再次检查：图中中文字符总数必须落在 16-28 个中文字符 区间内，不少于 16、不多于 28。",
  "side_30": "语言=简体中文。硬性要求：图中出现的所有文字、标题、标注、尺寸标注、单位、卖点文字、贴纸、品牌词等全部必须使用简体中文，严禁出现英文、日文、韩文或其他外语字符。文字密度=常规：图中中文字符总量必须为 16-28 个中文字符（含所有标签、卖点、标注，每一个汉字计 1）；保持适中的标签与简短卖点说明，不空白也不堆砌。纯白色背景 (#FFFFFF)，三件装透气速干短袖 T 恤，服装鞋帽 男士速干 T 恤，采用透气速干面料，吸湿排汗效果佳。三件装包含黑白灰经典配色，适合运动健身或日常穿着，产品 30 度侧面角度，展示立体感和厚度，专业商拍光线，突出材质和工艺细节，1:1 比例，1024x1024 分辨率。基于图 1 合理推断，保持产品主体一致。最后提醒：图中渲染的每一个字符都必须是简体中文，即使产品描述中包含英文也要翻译成中文后再渲染到图中，不得直接保留英文字符。定稿前再次检查：图中中文字符总数必须落在 16-28 个中文字符 区间内，不少于 16、不多于 28。",
  "side_45": "语言=简体中文。硬性要求：图中出现的所有文字、标题、标注、尺寸标注、单位、卖点文字、贴纸、品牌词等全部必须使用简体中文，严禁出现英文、日文、韩文或其他外语字符。文字密度=常规：图中中文字符总量必须为 16-28 个中文字符（含所有标签、卖点、标注，每一个汉字计 1）；保持适中的标签与简短卖点说明，不空白也不堆砌。纯白色背景 (#FFFFFF)，三件装透气速干短袖 T 恤，服装鞋帽 男士速干 T 恤，采用透气速干面料，吸湿排汗效果佳。三件装包含黑白灰经典配色，适合运动健身或日常穿着，产品 45 度侧面角度，展示立体感和厚度，专业商拍光线，突出材质和工艺细节，1:1 比例，1024x1024 分辨率。基于图 1 合理推断，保持产品主体一致。最后提醒：图中渲染的每一个字符都必须是简体中文，即使产品描述中包含英文也要翻译成中文后再渲染到图中，不得直接保留英文字符。定稿前再次检查：图中中文字符总数必须落在 16-28 个中文字符 区间内，不少于 16、不多于 28。",
  "side_90": "语言=简体中文。硬性要求：图中出现的所有文字、标题、标注、尺寸标注、单位、卖点文字、贴纸、品牌词等全部必须使用简体中文，严禁出现英文、日文、韩文或其他外语字符。文字密度=常规：图中中文字符总量必须为 16-28 个中文字符（含所有标签、卖点、标注，每一个汉字计 1）；保持适中的标签与简短卖点说明，不空白也不堆砌。纯白色背景 (#FFFFFF)，三件装透气速干短袖 T 恤，服装鞋帽 男士速干 T 恤，采用透气速干面料，吸湿排汗效果佳。三件装包含黑白灰经典配色，适合运动健身或日常穿着，产品 90 度侧面角度，展示立体感和厚度，专业商拍光线，突出材质和工艺细节，1:1 比例，1024x1024 分辨率。基于图 1 合理推断，保持产品主体一致。最后提醒：图中渲染的每一个字符都必须是简体中文，即使产品描述中包含英文也要翻译成中文后再渲染到图中，不得直接保留英文字符。定稿前再次检查：图中中文字符总数必须落在 16-28 个中文字符 区间内，不少于 16、不多于 28。",
  "size_annotation": "语言=简体中文。硬性要求：图中出现的所有文字、标题、标注、尺寸标注、单位、卖点文字、贴纸、品牌词等全部必须使用简体中文，严禁出现英文、日文、韩文或其他外语字符。文字密度=常规：图中中文字符总量必须为 16-28 个中文字符（含所有标签、卖点、标注，每一个汉字计 1）；保持适中的标签与简短卖点说明，不空白也不堆砌。三件装透气速干短袖 T 恤，服装鞋帽 男士速干 T 恤，采用透气速干面料，吸湿排汗效果佳。三件装包含黑白灰经典配色，适合运动健身或日常穿着，旁放置参照物（手 / 硬币 / 尺子），标注关键尺寸线和数字，白底背景，清晰简洁的信息图风格，1:1 比例，1024x1024 分辨率。使用常见行业尺寸估计。最后提醒：图中渲染的每一个字符都必须是简体中文，即使产品描述中包含英文也要翻译成中文后再渲染到图中，不得直接保留英文字符。定稿前再次检查：图中中文字符总数必须落在 16-28 个中文字符 区间内，不少于 16、不多于 28。",
  "top_down": "语言=简体中文。硬性要求：图中出现的所有文字、标题、标注、尺寸标注、单位、卖点文字、贴纸、品牌词等全部必须使用简体中文，严禁出现英文、日文、韩文或其他外语字符。文字密度=常规：图中中文字符总量必须为 16-28 个中文字符（含所有标签、卖点、标注，每一个汉字计 1）；保持适中的标签与简短卖点说明，不空白也不堆砌。纯白色背景 (#FFFFFF)，三件装透气速干短袖 T 恤，服装鞋帽 男士速干 T 恤，采用透气速干面料，吸湿排汗效果佳。三件装包含黑白灰经典配色，适合运动健身或日常穿着，俯视产品视角，占画面 85%，无文字无水印无阴影，专业商业摄影，柔和均匀布光，高清细节，1:1 比例，1024x1024 分辨率。以图 1 主体为准合理推断俯视造型。最后提醒：图中渲染的每一个字符都必须是简体中文，即使产品描述中包含英文也要翻译成中文后再渲染到图中，不得直接保留英文字符。定稿前再次检查：图中中文字符总数必须落在 16-28 个中文字符 区间内，不少于 16、不多于 28。",
}
`;

exports[`buildImagePrompt — targetLanguage = 'en' produces a stable English prompt for each of the 10 built-in image types 1`] = `
{
  "detail_closeup": "LANGUAGE=EN. STRICT RULE: Any text, captions, annotations, labels, callouts, dimension numbers with units, brand words, or stickers rendered in the output image MUST be written in English only. Do NOT render any Chinese, Japanese, Korean, Cyrillic, or other non-Latin characters in the image. DENSITY=NORMAL: total on-image English text MUST be 8-16 words (count every standalone word). Use a moderate number of short labels and callouts — neither sparse nor crowded. 三件装透气速干短袖 T 恤 macro close-up of key details, texture / buttons / interfaces / stitching and craftsmanship details, 服装鞋帽 男士速干 T 恤, 采用透气速干面料，吸湿排汗效果佳。三件装包含黑白灰经典配色，适合运动健身或日常穿着, shallow depth of field, professional macro lighting, aspect ratio 1:1, 1024x1024 resolution. Zoom in reasonably from the main subject in image 1. Final reminder: every glyph rendered in the output image must be English; reject any Chinese characters even if the source product description contains them. Re-check before finalising: total on-image word count must land within 8-16 words — not below 8, not above 16.",
  "main_white_front": "LANGUAGE=EN. STRICT RULE: Any text, captions, annotations, labels, callouts, dimension numbers with units, brand words, or stickers rendered in the output image MUST be written in English only. Do NOT render any Chinese, Japanese, Korean, Cyrillic, or other non-Latin characters in the image. DENSITY=NORMAL: total on-image English text MUST be 8-16 words (count every standalone word). Use a moderate number of short labels and callouts — neither sparse nor crowded. Pure white background (#FFFFFF), 三件装透气速干短袖 T 恤, 服装鞋帽 男士速干 T 恤, 采用透气速干面料，吸湿排汗效果佳。三件装包含黑白灰经典配色，适合运动健身或日常穿着, product facing forward, centered and filling 85% of the frame, no text, no watermark, no shadows, professional commercial photography, soft even lighting, crisp high-resolution details, aspect ratio 1:1, 1024x1024 resolution. Reference image 1 to reproduce the front view. Final reminder: every glyph rendered in the output image must be English; reject any Chinese characters even if the source product description contains them. Re-check before finalising: total on-image word count must land within 8-16 words — not below 8, not above 16.",
  "packaging": "LANGUAGE=EN. STRICT RULE: Any text, captions, annotations, labels, callouts, dimension numbers with units, brand words, or stickers rendered in the output image MUST be written in English only. Do NOT render any Chinese, Japanese, Korean, Cyrillic, or other non-Latin characters in the image. DENSITY=NORMAL: total on-image English text MUST be 8-16 words (count every standalone word). Use a moderate number of short labels and callouts — neither sparse nor crowded. 三件装透气速干短袖 T 恤 and every accessory shot top-down as a flat lay, main product centered, 服装鞋帽 男士速干 T 恤, 采用透气速干面料，吸湿排汗效果佳。三件装包含黑白灰经典配色，适合运动健身或日常穿着, white background, tidy arrangement displaying the full unboxing contents, spacing kept between each accessory, aspect ratio 1:1, 1024x1024 resolution. The main product must match image 1. Final reminder: every glyph rendered in the output image must be English; reject any Chinese characters even if the source product description contains them. Re-check before finalising: total on-image word count must land within 8-16 words — not below 8, not above 16.",
  "scene": "LANGUAGE=EN. STRICT RULE: Any text, captions, annotations, labels, callouts, dimension numbers with units, brand words, or stickers rendered in the output image MUST be written in English only. Do NOT render any Chinese, Japanese, Korean, Cyrillic, or other non-Latin characters in the image. DENSITY=NORMAL: total on-image English text MUST be 8-16 words (count every standalone word). Use a moderate number of short labels and callouts — neither sparse nor crowded. 三件装透气速干短袖 T 恤 shown in a real-life use-case scenario, choose an appropriate real-world setting for the "服装鞋帽 男士速干 T 恤" category, 服装鞋帽 男士速干 T 恤, 采用透气速干面料，吸湿排汗效果佳。三件装包含黑白灰经典配色，适合运动健身或日常穿着, product clearly identifiable, natural lighting, lifestyle atmosphere, surface 3 core selling points automatically inferred from the description, aspect ratio 1:1, 1024x1024 resolution. Reference image 1 strictly for the product, the scene itself can be creative. Final reminder: every glyph rendered in the output image must be English; reject any Chinese characters even if the source product description contains them. Re-check before finalising: total on-image word count must land within 8-16 words — not below 8, not above 16.",
  "selling_point": "LANGUAGE=EN. STRICT RULE: Any text, captions, annotations, labels, callouts, dimension numbers with units, brand words, or stickers rendered in the output image MUST be written in English only. Do NOT render any Chinese, Japanese, Korean, Cyrillic, or other non-Latin characters in the image. DENSITY=NORMAL: total on-image English text MUST be 8-16 words (count every standalone word). Use a moderate number of short labels and callouts — neither sparse nor crowded. 三件装透气速干短袖 T 恤 product image, 服装鞋帽 男士速干 T 恤, 采用透气速干面料，吸湿排汗效果佳。三件装包含黑白灰经典配色，适合运动健身或日常穿着, annotate the 3 most critical selling points inferred from the description, arrows pointing to the corresponding locations, clean infographic design, on-brand feel, aspect ratio 1:1, 1024x1024 resolution. Reference image 1 strictly for the product. Final reminder: every glyph rendered in the output image must be English; reject any Chinese characters even if the source product description contains them. Re-check before finalising: total on-image word count must land within 8-16 words — not below 8, not above 16.",
  "side_30": "LANGUAGE=EN. STRICT RULE: Any text, captions, annotations, labels, callouts, dimension numbers with units, brand words, or stickers rendered in the output image MUST be written in English only. Do NOT render any Chinese, Japanese, Korean, Cyrillic, or other non-Latin characters in the image. DENSITY=NORMAL: total on-image English text MUST be 8-16 words (count every standalone word). Use a moderate number of short labels and callouts — neither sparse nor crowded. Pure white background (#FFFFFF), 三件装透气速干短袖 T 恤, 服装鞋帽 男士速干 T 恤, 采用透气速干面料，吸湿排汗效果佳。三件装包含黑白灰经典配色，适合运动健身或日常穿着, product at a 30-degree side angle, show three-dimensional form and thickness, professional studio lighting that emphasises material and craftsmanship, aspect ratio 1:1, 1024x1024 resolution. Infer reasonably from image 1, keeping the main subject consistent. Final reminder: every glyph rendered in the output image must be English; reject any Chinese characters even if the source product description contains them. Re-check before finalising: total on-image word count must land within 8-16 words — not below 8, not above 16.",
  "side_45": "LANGUAGE=EN. STRICT RULE: Any text, captions, annotations, labels, callouts, dimension numbers with units, brand words, or stickers rendered in the output image MUST be written in English only. Do NOT render any Chinese, Japanese, Korean, Cyrillic, or other non-Latin characters in the image. DENSITY=NORMAL: total on-image English text MUST be 8-16 words (count every standalone word). Use a moderate number of short labels and callouts — neither sparse nor crowded. Pure white background (#FFFFFF), 三件装透气速干短袖 T 恤, 服装鞋帽 男士速干 T 恤, 采用透气速干面料，吸湿排汗效果佳。三件装包含黑白灰经典配色，适合运动健身或日常穿着, product at a 45-degree side angle, show three-dimensional form and thickness, professional studio lighting that emphasises material and craftsmanship, aspect ratio 1:1, 1024x1024 resolution. Infer reasonably from image 1, keeping the main subject consistent. Final reminder: every glyph rendered in the output image must be English; reject any Chinese characters even if the source product description contains them. Re-check before finalising: total on-image word count must land within 8-16 words — not below 8, not above 16.",
