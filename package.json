{
  "name": "AI-Sourcing-Platform-API",
  "version": "2.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "chetaidou:init": "node --env-file-if-exists=.env scripts/init-chetaidou-production.mjs",
    "chetaidou:init:test": "node --test scripts/chetaidou/*.test.mjs",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "import:product-publish-classifications": "node --env-file-if-exists=.env -r ts-node/register scripts/import-product-publish-classifications.ts",
    "normalize:product-publish-classifications": "node --env-file-if-exists=.env -r ts-node/register scripts/normalize-product-publish-classifications.ts",
    "restore:product-publish-classifications": "node --env-file-if-exists=.env -r ts-node/register scripts/normalize-product-publish-classifications.ts --restore",
    "export:product-publish-store-classifications": "node --env-file-if-exists=.env -r ts-node/register scripts/export-product-publish-store-classifications.ts",
    "sync:product-publish-stores": "node --env-file-if-exists=.env -r ts-node/register scripts/sync-product-publish-stores.ts",
    "upload:product-publish-templates": "node --env-file=.env scripts/upload-product-publish-templates.mjs",
    "sync:product-publish-templates": "node --env-file-if-exists=.env -r ts-node/register scripts/sync-product-publish-templates.ts",
    "sync:ai-split-models": "node --env-file-if-exists=.env -r ts-node/register scripts/sync-ai-split-models.ts",
    "sync:ai-gateway-video-models": "node --env-file-if-exists=.env -r ts-node/register scripts/sync-ai-gateway-video-models.ts",
    "sync:ai-gateway-models": "node --env-file-if-exists=.env -r ts-node/register scripts/sync-ai-gateway-models.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "gateway:image-models": "node scripts/pull-gateway-image-models.cjs",
    "gateway:image-price": "node -r ts-node/register scripts/set-image-price-multiplier.ts",
    "image-generation:size-test": "node -r ts-node/register scripts/test-image-generation-sizing.ts"
  },
  "dependencies": {
    "@alicloud/dm20151123": "^1.10.2",
    "@alicloud/pop-core": "^1.8.0",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@google/genai": "^1.50.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.6",
    "@prisma/client": "^6.19.3",
    "@zhiqingresearch/ai-ts-sdk": "^0.14.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ali-oss": "^6.23.0",
    "argon2": "^0.44.0",
    "axios": "^1.15.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.2.3",
    "form-data": "^4.0.5",
    "jsonrepair": "^3.14.0",
    "mammoth": "^1.12.1",
    "nest-winston": "^1.10.2",
    "nodemailer": "^9.0.0",
    "openai": "^6.49.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^2.4.5",
    "prisma": "^6.19.3",
    "puppeteer-core": "^25.8.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.4",
    "stripe": "^22.5.0",
    "undici": "^8.10.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/ali-oss": "^6.23.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
